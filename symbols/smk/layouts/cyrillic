// Cyrillic Alphabet | XKB Keyboard Symbols
// [AUTHOR]: Carlos González Sanz

// [NOTE]: These keyboards are partially based upon the
// default "ru" and "es" symbols in regards to the
// physical key layout.
//
// Put this file on either ~/.config/xkb/symbols
// or in the same directory as
// the other system-wide keyboard layouts.

// Default SMK-Cyrillic Keyboard
default partial alphanumeric_keys
xkb_symbols "basic" {
    // [NOTE]: Keys are arranged the same way as
    // in the standard Spanish QWERTY keyboard
    // but with Cyrillic letters instead.

    // [KEYBOARD LAYOUT REFERENCE (Expanded from SMK v15.x)]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ ª ◌ │ ! 𐤀 │ " ᵅ │ ·   │ $   │ %   │ &   │ /   │ ( ↻ │ )   │ = ↺ │ ? Ӏ │ ¿ ˮ ┃ ⌫       ┃
    // │ º \ │ 1 | │ 2 @ │ 3 # │ 4 ◌̃ │ 5  ᷏ │ 6 ¬ │ 7 ◌̸ │ 8 ∝ │ 9  ᷘ │ 0  ͚ │ ' ӏ │ ¡ ʼ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ԛ Ҁ │ Ь Ъ │ Е Ѣ │ Р ¤ │ Т Ѳ │ Я Ы │ У Ю │ И І │ О Ѡ │ П Ѱ │ ◌̂ ◌̏ │ * ◌̛ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ԛ ҁ │ ь ъ │ е ѣ │ р ₽ │ т ѳ │ я ы │ у ю │ и і │ о ѡ │ п ѱ │ ◌̀ [ │ + ] ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ А Э │ С Ш │ Д Ѕ │ Ф   │ Г Ґ │ Һ   │ Ј Ѵ │ К Ҡ │ Л Љ │ Њ ◌̌ │ ◌̈ ◌̋ │ Ч ◌̨ ┃      ┃
    // ┃  Lock  ┃ а э │ с ш │ д ѕ │ ф   │ г ґ │ һ ₴ │ ј ѵ │ к ҡ │ л љ │ њ ◌̄ │ ◌́ { │ ч } ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ > Є │ З Ж │ Х Щ │ Ц ◌̑ │ В ◌̊ │ Б ⌬ │ Н   │ М  ͛ │ ;   │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ < є │ з ж │ х щ │ ц ◌̧ │ в ◌̆ │ б ※ │ н   │ м ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    name[Group1]= "SMK-Cyrillic (ԚЬЕРТЯ)";

    key <TLDE>	{ [         masculine,  ordfeminine,       backslash,                   U25CC                       ] };    // U+25CC = Dotted Circle
    key <AE01>	{ [                 1,  exclam,            bar,                         U10900                      ] };    // U+10900 = Phoenician ʾĀlep ("Phoenician Type" Dead Key)
    key <AE02>	{ [                 2,  quotedbl,          at,                          dead_greek                  ] };
    key <AE03>	{ [                 3,  periodcentered,    numbersign                   ] };
    key <AE04>	{ [                 4,  dollar,            dead_tilde                   ] };
    key <AE05>	{ [                 5,  percent,           U1DCF                        ] };                                // U+1DCF = "Letter Fusion" Dead Key
    key <AE06>	{ [                 6,  ampersand,         notsign                      ] };
    key <AE07>	{ [                 7,  slash,             dead_longsolidusoverlay      ] };
    key <AE08>	{ [                 8,  parenleft,         U221D,                       U21BB                       ] };    // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [                 9,  parenright,        U1DFB                        ] };                                // U+1DFB = "Historical Letters" Dead Key
    key <AE10>	{ [                 0,  equal,             U035A,                       U21BA                       ] };    // U+035A = "IPA Symbols" Dead Key; U+21BA = "Letter Flip" Dead Key
    key <AE11>	{ [        apostrophe,  question,          U04C0,                       U04CF                       ] };    // "'", "?", Lowercase Palochka, Uppercase Palochka 
    key <AE12>	{ [        exclamdown,  questiondown,      U02BC,                       U02EE                       ] };    // "¡", "¿", Modifier Letter Apostrophe, Modifier Letter Double Apostrophe 

    key <AD01>	{ [             U051B,  U051A,             U0481,                       U0480                       ] };    // Lowercase Cyrillic Qa, Uppercase Cyrillic Qa, Lowercase , Uppercase Cyrillic Qoppa
    key <AD02>	{ [ Cyrillic_softsign,  Cyrillic_SOFTSIGN, Cyrillic_hardsign,           Cyrillic_HARDSIGN           ] };
    key <AD03>	{ [       Cyrillic_ie,  Cyrillic_IE,       U048D,                       U048C                       ] };    // "е", "Е", Lowercase Yat, Uppercase Yat
    key <AD04>	{ [       Cyrillic_er,  Cyrillic_ER,       U20BD,                       dead_currency               ] };    // "р", "Р", Ruble Sign (₽); "Currency Symbols" Dead Key
    key <AD05>	{ [       Cyrillic_te,  Cyrillic_TE,       U0473,                       U0472                       ] };    // "т", "Т", Lowercase Fita, Uppercase Fita
    key <AD06>	{ [       Cyrillic_ya,  Cyrillic_YA,       Cyrillic_yeru,               Cyrillic_YERU               ] };
    key <AD07>	{ [        Cyrillic_u,  Cyrillic_U,        Cyrillic_yu,                 Cyrillic_YU                 ] };
    key <AD08>	{ [        Cyrillic_i,  Cyrillic_I,        Ukrainian_i,                 Ukrainian_I                 ] };
    key <AD09>	{ [        Cyrillic_o,  Cyrillic_O,        U0461,                       U0460                       ] };    // "о", "О", Lowercase Cyrillic Omega, Uppercase Cyrillic Omega
    key <AD10>	{ [       Cyrillic_pe,  Cyrillic_PE,       U0471,                       U0470                       ] };    // "п", "П", Lowercase Cyrillic Psi, Uppercase Cyrillic Psi
    key <AD11>	{ [        dead_grave,  dead_circumflex,   bracketleft,                 dead_doublegrave            ] };
    key <AD12>	{ [              plus,  asterisk,          bracketright,                dead_horn                   ] };

    key <AC01>	{ [        Cyrillic_a,  Cyrillic_A,        Cyrillic_e,                  Cyrillic_E                  ] };
    key <AC02>	{ [       Cyrillic_es,  Cyrillic_ES,       Cyrillic_sha,                Cyrillic_SHA                ] };
    key <AC03>	{ [       Cyrillic_de,  Cyrillic_DE,       Macedonia_dse,               Macedonia_DSE               ] };
    key <AC04>	{ [       Cyrillic_ef,  Cyrillic_EF        ] };
    key <AC05>	{ [      Cyrillic_ghe,  Cyrillic_GHE,      Ukrainian_ghe_with_upturn,   Ukrainian_GHE_WITH_UPTURN   ] };
    key <AC06>	{ [     Cyrillic_shha,  Cyrillic_SHHA,     U20B4                        ] };                                // "Һ", "һ", Hryvnia Sign (₴)
    key <AC07>	{ [       Cyrillic_je,  Cyrillic_JE,       U0475,                       U0474                       ] };    // "ј", "Ј", Lowercase Izhitsa, Uppercase Izhitsa
    key <AC08>	{ [       Cyrillic_ka,  Cyrillic_KA,       U04A1,                       U04A0                       ] };    // "к", "К", Lowercase Bashkir Ka, Uppercase Bashkir Ka
    key <AC09>	{ [       Cyrillic_el,  Cyrillic_EL,       Cyrillic_lje,                Cyrillic_LJE                ] };
    key <AC10>	{ [      Cyrillic_nje,  Cyrillic_NJE,      dead_macron,                 dead_caron                  ] };
    key <AC11>	{ [        dead_acute,  dead_diaeresis,    braceleft,                   dead_doubleacute            ] };
    key <BKSL>	{ [      Cyrillic_che,  Cyrillic_CHE,      braceright,                  dead_ogonek                 ] };

    key <LSGT>	{ [              less,  greater,           Ukrainian_ie,                Ukrainian_IE                ] };
    key <AB01>	{ [       Cyrillic_ze,  Cyrillic_ZE,       Cyrillic_zhe,                Cyrillic_ZHE                ] };
    key <AB02>	{ [       Cyrillic_ha,  Cyrillic_HA,       Cyrillic_shcha,              Cyrillic_SHCHA              ] };
    key <AB03>	{ [      Cyrillic_tse,  Cyrillic_TSE,      dead_cedilla,                dead_invertedbreve          ] };
    key <AB04>	{ [       Cyrillic_ve,  Cyrillic_VE,       dead_breve,                  dead_abovering              ] };
    key <AB05>	{ [       Cyrillic_be,  Cyrillic_BE,       U203B,                       U232C                       ] };    // U+203B = "Punctuation Marks" Dead Key; U+232C = "Miscellaneous Symbols" Dead Key
    key <AB06>	{ [       Cyrillic_en,  Cyrillic_EN        ] };
    key <AB07>	{ [       Cyrillic_em,  Cyrillic_EM,       U0359,                       U035B                       ] };    // U+0359 = "Hooktail" Dead Key, U+035B = "Curly Loop" Dead Key
    key <AB08>	{ [             comma,  semicolon,         dead_belowcomma              ] };
    key <AB09>	{ [            period,  colon,             dead_abovedot,               dead_belowdot               ] };
    key <AB10>	{ [             minus,  underscore,        dead_stroke,                 dead_hook                   ] };
    key <SPCE>  { [             space,  space,             nobreakspace                 ] };

    // Default modifiers
    include "level3(ralt_switch)"
    include "compose(rctrl-altgr)"  // As a middle ground (feel free to change this line if you want or need to)
};

partial alphanumeric_keys
xkb_symbols "qwerty" {
    include "smk/cyrillic(basic)"
};

partial alphanumeric_keys
xkb_symbols "qwerty_pt" {
    // [NOTE]: This layout is based off a mixture between
    // the Portuguese & Spanish QWERTY keyboards
    // as well as the Russian ЙЦУКЕН one with some
    // custom rearrangements.

    // [KEYBOARD LAYOUT REFERENCE]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ | ˮ │ !   │ " ᵅ │ # · │ $   │ %   │ &   │ / ◌̸ │ ( ∝ │ ) ↻ │ = ↺ │ ? Ӏ │ » ¿ ┃ ⌫       ┃
    // │ \ ʼ │ 1 𐤀‎ │ 2 @ │ 3 £ │ 4 § │ 5  ᷏ │ 6 ¬ │ 7 { │ 8 [ │ 9 ] │ 0 } │ ' ӏ │ « ¡ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ԛ Ҁ │ Ь Ъ │ Е Ѣ │ Р ¤ │ Т Ѳ │ Я Ы │ У Ю │ И І │ О Ѡ │ П Ѱ │ ◌̂ ◌̏ │ * ◌̛ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ԛ ҁ │ ь ъ │ е ѣ │ р ₽ │ т ѳ │ я ы │ у ю │ и і │ о ѡ │ п ѱ │ ◌̀ [ │ + ] ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ А Э │ С Ш │ Д Ѕ │ Ф   │ Г Ґ │ Һ   │ Ј Ѵ │ К Ҡ │ Л Љ │ Ч ◌̌ │ ª  ͚ │ ◌̂ ◌̨ ┃      ┃
    // ┃  Lock  ┃ а э │ с ш │ д ѕ │ ф   │ г ґ │ һ ₴ │ ј ѵ │ к ҡ │ л љ │ ч ◌̄ │ º  ᷘ │ ◌̃ ◌̛ ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ > Є │ З Ж │ Х Щ │ Ц ◌̑ │ В ◌̊ │ Б ⌬ │ Н   │ М  ͛ │ ;   │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ < є │ з ж │ х щ │ ц ◌̧ │ в ◌̆ │ б ※ │ н   │ м ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    include "smk/cyrillic(basic)"

    name[Group1]= "SMK-Cyrillic (Portuguese ԚЬЕРТЯ)";

    key <TLDE>	{ [     backslash,  bar,               U02BC,                  U02EE                   ] }; // "¡", "¿", Modifier Letter Apostrophe, Modifier Letter Double Apostrophe 
    key <AE01>	{ [             1,  exclam,            U10900                  ] };                         // U+10900 = Phoenician ʾĀlep ("Phoenician Type" Dead Key)
    key <AE03>	{ [             3,  numbersign,        sterling,               periodcentered          ] };
    key <AE04>	{ [             4,  dollar,            section                 ] };
    key <AE07>	{ [             7,  slash,             braceleft,              dead_longsolidusoverlay ] };
    key <AE08>	{ [             8,  parenleft,         bracketleft,            U221D                   ] }; // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [             9,  parenright,        bracketright,           U21BB                   ] }; // U+21BB = "Arrows" Dead Key
    key <AE10>	{ [             0,  equal,             braceright,             U21BA                   ] }; // U+21BA = "Letter Flip" Dead Key
    key <AE12>	{ [ guillemetleft,  guillemetright,    exclamdown,             questiondown            ] };

    key <AD11>	{ [          plus,  asterisk,          dead_diaeresis,         U25CC                   ] }; // U+25CC = Dotted Circle
    key <AD12>	{ [    dead_acute,  dead_grave,        dead_doubleacute,       dead_doublegrave        ] };

    key <AC10>	{ [  Cyrillic_che,  Cyrillic_CHE,      dead_macron,            dead_caron              ] };
    key <AC11>	{ [     masculine,  ordfeminine,       U1DCF,                  U035A                   ] }; // U+1DCF = "Letter Fusion" Dead Key; U+035A = "IPA Symbols" Dead Key 
    key <BKSL>	{ [    dead_tilde,  dead_circumflex,   dead_horn,              dead_ogonek             ] };
};

