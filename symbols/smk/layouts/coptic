// [NOTE]: These keyboards are partially based upon the
// default "es" symbols in regards to the
// physical key layout.
//
// Put this file on either ~/.config/xkb/symbols
// or in the same directory as
// the other system-wide keyboard layouts.

// Default SMK-Coptic Keyboard
default partial alphanumeric_keys
xkb_symbols "basic" {
    // [NOTE]: Keys are arranged the same way as
    // in the standard Spanish QWERTY keyboard,
    // except with Coptic letters instead of Latin ones.

    // [KEYBOARD LAYOUT REFERENCE]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ ª ◌ │ ! 𐤀 │ " ᵅ │ ·   │ $   │ %   │ & ⳤ │ / ⳽ │ ( ↻ │ ) ⳿ │ = ↺ │ ? Ⲳ │ ¿ Ⲵ ┃ ⌫       ┃
    // │ º \ │ 1 | │ 2 @ │ 3 # │ 4 ◌̃ │ 5  ᷏ │ 6 ¬ │ 7 ◌̸ │ 8 ∝ │ 9  ᷘ │ 0  ͚ │ ' ⲳ │ ¡ ⲵ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ⳝ   │ Ⳣ   │ Ⲉ ¤ │ Ⲣ   │ Ⲧ Ⲑ │ Ⲏ   │ Ⲩ   │ Ⲓ   │ Ⲟ Ⲱ │ Ⲡ Ⲯ │ ◌̂ ◌̏ │ * ◌̛ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ⳝ   │ ⳣ   │ ⲉ € │ ⲣ   │ ⲧ ⲑ │ ⲏ   │ ⲩ   │ ⲓ   │ ⲟ ⲱ │ ⲡ ⲯ │ ◌̀ [ │ + ] ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ Ⲁ   │ Ⲥ Ϣ │ Ⲇ Ϯ │ Ⲫ Ϥ │ Ⲅ Ϫ │ Ϩ Ⳉ │ Ⲭ Ϧ │ Ⲕ Ⳳ │ Ⲗ   │ Ⳡ ◌̌ │ ◌̈ ◌̋ │ Ϭ ◌̨ ┃      ┃
    // ┃  Lock  ┃ ⲁ   │ ⲥ ϣ │ ⲇ ϯ │ ⲫ ϥ │ ⲅ ϫ │ ϩ ⳉ │ ⲭ ϧ │ ⲕ ⳳ │ ⲗ   │ ⳡ ◌̄ │ ◌́ { │ ϭ } ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ >   │ Ⲍ Ⳃ │ Ⲝ   │ Ⲋ ◌̑ │ Ⳁ ◌̊ │ Ⲃ ⌬ │ Ⲛ Ⳟ │ Ⲙ  ͛ │ ;   │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ <   │ ⲍ ⳃ │ ⲝ   │ ⲋ ◌̧ │ ⳁ ◌̆ │ ⲃ ※ │ ⲛ ⳟ │ ⲙ ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    name[Group1]= "SMK-Coptic (ⳜⳢⲈⲢⲦⲎ)";

    key <TLDE>	{ [  masculine,  ordfeminine,       backslash,                  U25CC               ] };    // U+25CC = Dotted Circle
    key <AE01>	{ [          1,  exclam,            bar,                        U10900              ] };    // U+10900 = Phoenician ʾĀlep ("Phoenician Type" Dead Key)
    key <AE02>	{ [          2,  quotedbl,          at,                         dead_greek          ] };
    key <AE03>	{ [          3,  periodcentered,    numbersign                  ] };
    key <AE04>	{ [          4,  dollar,            dead_tilde                  ] };
    key <AE05>	{ [          5,  percent,           U1DCF                       ] };                        // U+1DCF = "Letter Fusion" Dead Key
    key <AE06>	{ [          6,  ampersand,         notsign,                    U2CE4               ] };    // U+2CE4 = Coptic Kai Symbol
    key <AE07>	{ [          7,  slash,             dead_longsolidusoverlay,    U2CFD               ] };    // U+2CFD = Coptic Fraction ½
    key <AE08>	{ [          8,  parenleft,         U221D,                      U21BB               ] };    // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [          9,  parenright,        U1DFB,                      U2CFF               ] };    // U+1DFB = "Historical Letters" Dead Key; U+2CFF = "Cryptogrammic Letters" Dead Key
    key <AE10>	{ [          0,  equal,             U035A,                      U21BA               ] };    // U+035A = "IPA Symbols" Dead Key; U+21BA = "Letter Flip" Dead Key
    key <AE11>	{ [ apostrophe,  question,          U2CB3,                      U2CB2               ] };    // "'", "?", Lowercase Coptic Alef, Uppercase Coptic Alef
    key <AE12>	{ [ exclamdown,  questiondown,      U2CB5,                      U2CB4               ] };    // "¡", "¿", Lowercase Coptic Ain, Uppercase Coptic Ain

    key <AD01>	{ [      U2CDD,  U2CDC              ] };                                                    // Ⳝ (Old Nubian Shima)
    key <AD02>	{ [      U2CE3,  U2CE2              ] };                                                    // Ⳣ (Old Nubian Wau)
    key <AD03>	{ [      U2C89,  U2C88,             EuroSign,                   dead_currency       ] };    // Ⲉ (Eie); "€", "Currency Symbols" Dead Key
    key <AD04>	{ [      U2CA3,  U2CA2              ] };                                                    // Ⲣ (Ro)
    key <AD05>	{ [      U2CA7,  U2CA6,             U2C91,                      U2C90               ] };    // Ⲧ (Coptic Tau); Ⲑ (Thethe)
    key <AD06>	{ [      U2C8F,  U2C8E              ] };                                                    // Ⲏ (Hate)
    key <AD07>	{ [      U2CA9,  U2CA8              ] };                                                    // Ⲩ (Ua)
    key <AD08>	{ [      U2C93,  U2C92              ] };                                                    // Ⲓ (Iauda)
    key <AD09>	{ [      U2C9F,  U2C9E,             U2CB1,                      U2CB0               ] };    // Ⲟ (Coptic O); Ⲱ (Ōu)
    key <AD10>	{ [      U2CA1,  U2CA0,             U2CAF,                      U2CAE               ] };    // Ⲡ (Coptic Pi); Ⲯ (Coptic Psi)
    key <AD11>	{ [ dead_grave,  dead_circumflex,   bracketleft,                dead_doublegrave    ] };
    key <AD12>	{ [       plus,  asterisk,          bracketright,               dead_horn           ] };

    key <AC01>	{ [      U2C81,  U2C80              ] };                                                    // Ⲁ (Coptic Alfa)
    key <AC02>	{ [      U2CA5,  U2CA4,             U03E3,                      U03E2               ] };    // Ⲥ (Sima); Ϣ (Shei)
    key <AC03>	{ [      U2C87,  U2C86,             U03EF,                      U03EE               ] };    // Ⲇ (Dalda); Ϯ (Dei)
    key <AC04>	{ [      U2CAB,  U2CAA,             U03E5,                      U03E4               ] };    // Ⲫ (Coptic Fi); Ϥ (Fei)
    key <AC05>	{ [      U2C85,  U2C84              ] };                                                    // Ⲅ (Coptic Gamma)
    key <AC06>	{ [      U03E9,  U03E8,             U2CC9,                      U2CC8               ] };    // Ϩ (Hori); Ⳉ (Akhmimic Khei)
    key <AC07>	{ [      U2CAD,  U2CAC,             U03E7,                      U03E6               ] };    // Ⲭ (Coptic Khi); Ϧ (Khei)
    key <AC08>	{ [      U2C95,  U2C94,             U2CF3,                      U2CF2               ] };    // Ⲕ (Kapa); Ⳳ (Bohairic Khei)
    key <AC09>	{ [      U2C97,  U2C96              ] };                                                    // Ⲗ (Laula)
    key <AC10>	{ [      U2CE1,  U2CE0,             dead_macron,                dead_caron          ] };    // Lowercase Old Nubian Nyi; Uppercase Old Nubian Nyi, "Macron" Dead Key, "Caron" Dead Key
    key <AC11>	{ [ dead_acute,  dead_diaeresis,    braceleft,                  dead_doubleacute    ] };
    key <BKSL>	{ [      U03ED,  U03EC,             braceright,                 dead_ogonek         ] };    // Lowercase Shima; Uppercase Shima, "}", "Ogonek" Dead Key

    key <LSGT>	{ [       less,  greater            ] };
    key <AB01>	{ [      U2C8D,  U2C8C,             U2CC3,                      U2CC2               ] };    // Ⲍ (Zata); Ⳃ (Crossed Shei)
    key <AB02>	{ [      U2C9D,  U2C9C              ] };                                                    // Ⲝ (Coptic Ksi)
    key <AB03>	{ [      U2C8B,  U2C8A,             dead_cedilla,               dead_invertedbreve  ] };    // Lowercase Sō; Uppercase Sō; "Cedilla" Dead Key, "Inverted Breve" Dead Key
    key <AB04>	{ [      U2CC1,  U2CC0,             dead_breve,                 dead_abovering      ] };    // Lowercase Coptic Sampi; Uppercase Coptic Sampi; "Breve" Dead Key, "Ring Above" Dead Key
    key <AB05>	{ [      U2C83,  U2C82,             U203B,                      U232C               ] };    // Ⲃ (Vida); U+203B = "Punctuation Marks" Dead Key; U+232C = "Miscellaneous Symbols" Dead Key
    key <AB06>	{ [      U2C9B,  U2C9A,             U2CDF,                      U2CDE               ] };    // Ⲛ (Coptic Ni); Ⳟ (Old Nubian Ngi)
    key <AB07>	{ [      U2C99,  U2C98,             U0359,                      U035B               ] };    // Ⲙ (Coptic Ni); U+0359 = "Hooktail" Dead Key, U+035B = "Curly Loop" Dead Key
    key <AB08>	{ [      comma,  semicolon,         dead_belowcomma             ] };
    key <AB09>	{ [     period,  colon,             dead_abovedot,              dead_belowdot       ] };
    key <AB10>	{ [      minus,  underscore,        dead_stroke,                dead_hook           ] };

    key <SPCE>  { [      space,  space,             nobreakspace                ] };

    // Default modifiers
    include "level3(ralt_switch)"
    include "compose(rctrl-altgr)"  // As a middle ground (feel free to change this line if you want or need to)
};

partial alphanumeric_keys
xkb_symbols "qwerty" {
    include "smk/coptic(basic)"
};

partial alphanumeric_keys
xkb_symbols "qwerty_pt" {
    // [NOTE]: This layout is based off a mixture between
    // the Portuguese QWERTY keyboard
    // and the Spanish QWERTY one with some
    // custom rearrangements, except with
    // Coptic letters instead of Latin ones.

    // [KEYBOARD LAYOUT REFERENCE]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ | Ⲵ │ !   │ " ᵅ │ # · │ $   │ % ⳽ │ & ⳤ │ / ◌̸ │ ( ∝ │ ) ↻ │ = ↺ │ ? Ⲳ │ » ¿ ┃ ⌫       ┃
    // │ \ ⲵ │ 1 𐤀‎ │ 2 @ │ 3 £ │ 4 § │ 5  ᷏ │ 6 ¬ │ 7 { │ 8 [ │ 9 ] │ 0 } │ ' ⲳ │ « ¡ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ⳝ   │ Ⳣ   │ Ⲉ ¤ │ Ⲣ   │ Ⲧ Ⲑ │ Ⲏ   │ Ⲩ   │ Ⲓ   │ Ⲟ Ⲱ │ Ⲡ Ⲯ │ * ◌ │ ◌̀ ◌̏ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ⳝ   │ ⳣ   │ ⲉ € │ ⲣ   │ ⲧ ⲑ │ ⲏ   │ ⲩ   │ ⲓ   │ ⲟ ⲱ │ ⲡ ⲯ │ + ◌̈ │ ◌́ ◌̋ ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ Ⲁ   │ Ⲥ Ϣ │ Ⲇ Ϯ │ Ⲫ Ϥ │ Ⲅ Ϫ │ Ϩ Ⳉ │ Ⲭ Ϧ │ Ⲕ Ⳳ │ Ⲗ   │ Ϭ ◌̌ │ ª  ͚ │ ◌̂ ◌̨ ┃      ┃
    // ┃  Lock  ┃ ⲁ   │ ⲥ ϣ │ ⲇ ϯ │ ⲫ ϥ │ ⲅ ϫ │ ϩ ⳉ │ ⲭ ϧ │ ⲕ ⳳ │ ⲗ   │ ϭ ◌̄ │ º  ᷘ │ ◌̃ ◌̛ ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ > Ⳡ │ Ⲍ Ⳃ │ Ⲝ   │ Ⲋ ◌̑ │ Ⳁ ◌̊ │ Ⲃ ⌬ │ Ⲛ Ⳟ │ Ⲙ  ͛ │ ; ◌̓ │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ < ⳡ │ ⲍ ⳃ │ ⲝ   │ ⲋ ◌̧ │ ⳁ ◌̆ │ ⲃ ※ │ ⲛ ⳟ │ ⲙ ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    include "smk/coptic(basic)"

    name[Group1]= "SMK-Greek (Portuguese ⳜⳢⲈⲢⲦⲎ)";

    key <TLDE>	{ [     backslash,  bar,               U2CB5,                  U2CB4                   ] };     // "\", "|", Lowercase Coptic Ain, Uppercase Coptic Ain
    key <AE01>	{ [             1,  exclam,            U10900                  ] };                             // U+10900 = Phoenician ʾĀlep ("Phoenician Type" Dead Key)
    key <AE03>	{ [             3,  numbersign,        sterling,               periodcentered          ] };
    key <AE04>	{ [             4,  dollar,            section                 ] };
    key <AE05>	{ [             5,  percent,           U1DCF,                  U2CFD                   ] };     // U+1DCF = "Letter Fusion" Dead Key; U+2CFD = Coptic Fraction ½
    key <AE07>	{ [             7,  slash,             braceleft,              dead_longsolidusoverlay ] };
    key <AE08>	{ [             8,  parenleft,         bracketleft,            U221D                   ] };     // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [             9,  parenright,        bracketright,           U21BB                   ] };     // U+21BB = "Arrows" Dead Key
    key <AE10>	{ [             0,  equal,             braceright,             U21BA                   ] };     // U+21BA = "Letter Flip" Dead Key
    key <AE12>	{ [ guillemetleft,  guillemetright,    exclamdown,             questiondown            ] };

    key <AD11>	{ [          plus,  asterisk,          dead_diaeresis,         U25CC                   ] };     // U+25CC = Dotted Circle
    key <AD12>	{ [    dead_acute,  dead_grave,        dead_doubleacute,       dead_doublegrave        ] };

    key <AC10>	{ [         U03ED,  U03EC,             dead_macron,            dead_caron              ] };     // Lowercase Shima; Uppercase Shima, "Macron" Dead Key, "Caron" Dead Key
    key <AC11>	{ [     masculine,  ordfeminine,       U1DCF,                  U035A                   ] };     // U+1DCF = "Letter Fusion" Dead Key; U+035A = "IPA Symbols" Dead Key
    key <BKSL>	{ [    dead_tilde,  dead_circumflex,   dead_horn,              dead_ogonek             ] };

    key <LSGT>	{ [          less,  greater,           U2CE1,                  U2CE0                   ] };     // "<", ">", Lowercase Old Nubian Nyi, Uppercase Old Nubian Nyi
};

