// Greek Alphabet | XKB Keyboard Symbols
// [AUTHOR]: Carlos González Sanz

// [NOTE]: These keyboards are partially based upon the
// default "latin" and "es" symbols in regards to the
// physical key layout.
//
// Put this file on either ~/.config/xkb/symbols
// or in the same directory as
// the other system-wide keyboard layouts.

// Default SMK-Greek Keyboard
default partial alphanumeric_keys
xkb_symbols "basic" {
    // [NOTE]: Keys are arranged the same way as
    // in the standard Spanish QWERTY keyboard
    // but with Greek letters instead.

    // [KEYBOARD LAYOUT REFERENCE (Expanded from SMK v15.x)]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ ª ◌ │ ! 𐤀 │ " ᵅ │ ·   │ $   │ %   │ &   │ /   │ ( ↻ │ )   │ = ↺ │ ?   │ ¿   ┃ ⌫       ┃
    // │ º \ │ 1 | │ 2 @ │ 3 # │ 4 ◌̃ │ 5  ᷏ │ 6 ¬ │ 7 ◌̸ │ 8 ∝ │ 9   │ 0  ͚ │ '   │ ¡   ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ϙ Ϟ │ Ϝ   │ Ε ¤ │ Ρ   │ Τ Θ │ Ϳ   │ Υ Ȣ │ Ι Η │ Ο Ω │ Π Ψ │ ◌̂ ◌̏ │ * ◌̛ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ϙ ϟ │ ϝ   │ ε € │ ρ   │ τ θ │ ϳ ◌ͅ │ υ ȣ │ ι η │ ο ω │ π ψ │ ◌̀ [ │ + ] ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ Α   │ Σ Ϸ │ Δ Ϡ │ Φ   │ Γ   │ Ͱ   │ Χ   │ Κ Ϗ │ Λ   │ ς ◌̌ │ ◌̈ ◌̋ │ Ϛ ◌̨ ┃      ┃
    // ┃  Lock  ┃ α   │ σ ϸ │ δ ϡ │ φ   │ γ   │ ͱ ◌̔ │ χ   │ κ ϗ │ λ   │ ς ◌̄ │ ◌́ { │ ϛ } ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ >   │ Ζ Ͳ │ Ξ Ϲ │ Ϻ ◌̑ │ Ͷ ◌̊ │ Β ⌬ │ Ν   │ Μ  ͛ │ ; ◌̓ │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ <   │ ζ ͳ │ ξ ϲ │ ϻ ◌̧ │ ͷ ◌̆ │ β ※ │ ν   │ μ ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    name[Group1]= "SMK-Greek (ϘϜΕΡΤͿ)";

    key <TLDE>	{ [             masculine,  ordfeminine,            backslash,              U25CC               ] };    // U+25CC = Dotted Circle
    key <AE01>	{ [                     1,  exclam,                 bar,                    U10900              ] };    // U+10900 = Phoenician ʾĀlep ("Phoenician Type" Dead Key)
    key <AE02>	{ [                     2,  quotedbl,               at,                     dead_greek          ] };
    key <AE03>	{ [                     3,  periodcentered,         numbersign              ] };
    key <AE04>	{ [                     4,  dollar,                 dead_tilde              ] };
    key <AE05>	{ [                     5,  percent,                U1DCF                   ] };                        // U+1DCF = "Letter Fusion" Dead Key
    key <AE06>	{ [                     6,  ampersand,              notsign                 ] };
    key <AE07>	{ [                     7,  slash,                  dead_longsolidusoverlay ] };
    key <AE08>	{ [                     8,  parenleft,              U221D,                  U21BB               ] };    // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [                     9,  parenright              ] };
    key <AE10>	{ [                     0,  equal,                  U035A,                  U21BA               ] };    // U+035A = "IPA Symbols" Dead Key; U+21BA = "Letter Flip" Dead Key
    key <AE11>	{ [            apostrophe,  question                ] };
    key <AE12>	{ [            exclamdown,  questiondown            ] };

    key <AD01>	{ [                 U03D8,  U03D9,                  U03DF,                  U03DE               ] };    // Lowercase Archaic Greek Koppa, Uppercase Archaic Greek Koppa, Lowercase Greek Koppa, Uppercase Greek Koppa
    key <AD02>	{ [                 U03DD,  U03DC                   ] };                                                // Lowercase Digamma, Uppercase Digamma
    key <AD03>	{ [         Greek_epsilon,  Greek_EPSILON,          EuroSign,               dead_currency       ] };
    key <AD04>	{ [             Greek_rho,  Greek_RHO               ] };
    key <AD05>	{ [             Greek_tau,  Greek_TAU,              Greek_theta,            Greek_THETA         ] };
    key <AD06>	{ [                 U03F3,  U037F,                  dead_iota               ] };                        // Lowercase Yot, Uppercase Yot, "Adscript/Subscript Iota" Dead Key
    key <AD07>	{ [         Greek_upsilon,  Greek_UPSILON,          U0223,                  U0222               ] };    // "υ", "Υ", Lowercase Greek-Latin Ou, Uppercase Greek-Latin Ou
    key <AD08>	{ [            Greek_iota,  Greek_IOTA,             Greek_eta,              Greek_ETA           ] };
    key <AD09>	{ [         Greek_omicron,  Greek_OMICRON,          Greek_omega,            Greek_OMEGA         ] };
    key <AD10>	{ [              Greek_pi,  Greek_PI,               Greek_psi,              Greek_PSI           ] };
    key <AD11>	{ [            dead_grave,  dead_circumflex,        bracketleft,            dead_doublegrave    ] };
    key <AD12>	{ [                  plus,  asterisk,               bracketright,           dead_horn           ] };

    key <AC01>	{ [           Greek_alpha,  Greek_ALPHA             ] };
    key <AC02>	{ [           Greek_sigma,  Greek_SIGMA,            U03F8,                  U03F7               ] };    // "σ", "Σ", Lowercase Sho, Uppercase Sho
    key <AC03>	{ [           Greek_delta,  Greek_DELTA,            U03E1,                  U03E0               ] };    // "δ", "Δ", Lowercase Sampi, Uppercase Sampi
    key <AC04>	{ [             Greek_phi,  Greek_PHI               ] };
    key <AC05>	{ [           Greek_gamma,  Greek_GAMMA             ] };
    key <AC06>	{ [                 U0371,  U0370,                  dead_abovereversedcomma ] };                        // Lowercase Heta, Uppercase Heta, "Reversed Comma Above/Dasia" Dead Key
    key <AC07>	{ [             Greek_chi,  Greek_CHI               ] };
    key <AC08>	{ [           Greek_kappa,  Greek_KAPPA,            U03D7,                  U03CF               ] };    // "κ", "Κ", Lowercase Kai, Uppercase Kai
    key <AC09>	{ [          Greek_lambda,  Greek_LAMBDA            ] };
    key <AC10>	{ [ Greek_finalsmallsigma,  Greek_finalsmallsigma,  dead_macron,            dead_caron          ] };
    key <AC11>	{ [            dead_acute,  dead_diaeresis,         braceleft,              dead_doubleacute    ] };
    key <BKSL>	{ [                 U03DB,  U03DA,                  braceright,             dead_ogonek         ] };    // Lowercase Stigma, Uppercase Stigma, "}", "Ogonek" Dead Key
    
    key <LSGT>	{ [                  less,  greater                 ] };
    key <AB01>	{ [            Greek_zeta,  Greek_ZETA,             U0373,                  U0372               ] };    // "ζ", "Ζ", Lowercase Archaic Sampi, Uppercase Archaic Sampi
    key <AB02>	{ [              Greek_xi,  Greek_XI,               U03F2,                  U03F9               ] };    // "ξ", "Ξ", Lowercase Lunate Sigma, Uppercase Lunate Sigma
    key <AB03>	{ [                 U03FB,  U03FA,                  dead_cedilla,           dead_invertedbreve  ] };    // Lowercase San, Uppercase San, "Cedilla" Dead Key, "Inverted Breve" Dead Key
    key <AB04>	{ [                 U0377,  U0376,                  dead_breve,             dead_abovering      ] };    // Lowercase Pamphylian Digamma, Uppercase Pamphylian Digamma, "Cedilla" Dead Key, "Inverted Breve" Dead Key
    key <AB05>	{ [            Greek_beta,  Greek_BETA,             U203B,                  U232C               ] };    // U+203B = "Punctuation Marks" Dead Key; U+232C = "Miscellaneous Symbols" Dead Key
    key <AB06>	{ [              Greek_nu,  Greek_NU                ] };
    key <AB07>	{ [              Greek_mu,  Greek_MU,               U0359,                  U035B               ] };    // U+0359 = "Hooktail" Dead Key, U+035B = "Curly Loop" Dead Key
    key <AB08>	{ [                 comma,  semicolon,              dead_belowcomma,        dead_abovecomma     ] };
    key <AB09>	{ [                period,  colon,                  dead_abovedot,          dead_belowdot       ] };
    key <AB10>	{ [                 minus,  underscore,             dead_stroke,            dead_hook           ] };

    key <SPCE>  { [                 space,  space,                  nobreakspace            ] };

    // Default modifiers
    include "level3(ralt_switch)"
    include "compose(rctrl-altgr)"  // As a middle ground (feel free to change this line if you want or need to)
};

partial alphanumeric_keys
xkb_symbols "qwerty" {
    include "smk/greek(basic)"
};

partial alphanumeric_keys
xkb_symbols "qwerty_pt" {
    // [NOTE]: This layout is based off a mixture between
    // the Portuguese QWERTY keyboard
    // and the Spanish QWERTY one with some
    // custom rearrangements and Greek letters.

    // [KEYBOARD LAYOUT REFERENCE]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ |   │ !   │ " ᵅ │ # · │ $   │ %   │ &   │ / ◌̸ │ ( ∝ │ ) ↻ │ = ↺ │ ?   │ » ¿ ┃ ⌫       ┃
    // │ \   │ 1 𐤟 │ 2 @ │ 3 £ │ 4 § │ 5  ᷏ │ 6 ¬ │ 7 { │ 8 [ │ 9 ] │ 0 } │ '   │ « ¡ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ϙ Ϟ │ Ϝ   │ Ε ¤ │ Ρ   │ Τ Θ │ Ϳ   │ Υ Ȣ │ Ι Η │ Ο Ω │ Π Ψ │ * ◌ │ ◌̀ ◌̏ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ϙ ϟ │ ϝ   │ ε € │ ρ   │ τ θ │ ϳ ◌ͅ │ υ ȣ │ ι η │ ο ω │ π ψ │ + ◌̈ │ ◌́ ◌̋ ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ Α   │ Σ Ϸ │ Δ Ϡ │ Φ   │ Γ   │ Ͱ   │ Χ   │ Κ Ϗ │ Λ ς │ Ϛ ◌̌ │ ª   │ ◌̂ ◌̨ ┃      ┃
    // ┃  Lock  ┃ α   │ σ ϸ │ δ ϡ │ φ   │ γ   │ ͱ ◌̔ │ χ   │ κ ϗ │ λ ς │ ϛ ◌̄ │ º  ͚ │ ◌̃ ◌̛ ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ >   │ Ζ Ͳ │ Ξ Ϲ │ Ϻ ◌̑ │ Ͷ ◌̊ │ Β ⌬ │ Ν   │ Μ  ͛ │ ; ◌̓ │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ <   │ ζ ͳ │ ξ ϲ │ ϻ ◌̧ │ ͷ ◌̆ │ β ※ │ ν   │ μ ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    include "smk/greek(basic)"

    name[Group1]= "SMK-Greek (Portuguese ϘϜΕΡΤͿ)";

    key <AE01>	{ [             1,  exclam,            U10900                  ] };                             // U+10900 = Phoenician ʾĀlep ("Phoenician Type" Dead Key)
    key <AE03>	{ [             3,  numbersign,        sterling,               periodcentered          ] };
    key <AE04>	{ [             4,  dollar,            section                 ] };
    key <AE07>	{ [             7,  slash,             braceleft,              dead_longsolidusoverlay ] };
    key <AE08>	{ [             8,  parenleft,         bracketleft,            U221D                   ] };     // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [             9,  parenright,        bracketright,           U21BB                   ] };     // U+21BB = "Arrows" Dead Key
    key <AE10>	{ [             0,  equal,             braceright,             U21BA                   ] };     // U+21BA = "Letter Flip" Dead Key
    key <AE12>	{ [ guillemetleft,  guillemetright,    exclamdown,             questiondown            ] };

    key <AD11>	{ [          plus,  asterisk,          dead_diaeresis,         U25CC                   ] };     // U+25CC = Dotted Circle
    key <AD12>	{ [    dead_acute,  dead_grave,        dead_doubleacute,       dead_doublegrave        ] };

    key <AC10>	{ [         U03DB,  U03DA,             dead_macron,            dead_caron              ] };     // Lowercase Stigma, Uppercase Stigma, "Macron" Dead Key, "Ogonek" Dead Key
    key <AC11>	{ [     masculine,  ordfeminine,       U035A                   ] };                             // U+035A = "IPA Symbols" Dead Key 
    key <BKSL>	{ [    dead_tilde,  dead_circumflex,   dead_horn,              dead_ogonek             ] };
};

