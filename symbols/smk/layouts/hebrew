    // ┃Shift ┃ \   │ ז‎ זּ‎ │ ח‎   │ צ‎   │ ב‎   │ בּ‎ ※ │ נ‎ נּ‎ │ מ‎ מּ‎ │ , ◌֒ │ .   │ /   ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
