    // ┃ Tab ↹ ┃ ק‎   │ ו‎ וּ‎ │ ◌ֶ ◌ֵ │ ר‎ רּ‎ │ ת‎ ט‎ │ י‎‎ יּ‎ │ ◌ֻ   │ ◌ִ   │ ◌ֹ ◌ֺ │ פ‎ פּ‎ │ [ א‎ │ ] ע‎ ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
