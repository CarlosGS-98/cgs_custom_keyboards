// Armenian Alphabet | XKB Keyboard Symbols
// [AUTHOR]: Carlos González Sanz

// [NOTE]: These keyboards are partially based upon the
// default "am" and "es" symbols in regards to the
// physical key layout.
//
// Put this file on either ~/.config/xkb/symbols
// or in the same directory as
// the other system-wide keyboard layouts.

// Default SMK-Armenian Keyboard
default partial alphanumeric_keys
xkb_symbols "basic" {
    // [NOTE]: Keys are arranged the same way as
    // in the standard Spanish QWERTY keyboard
    // but with Armenian letters instead.

    // [KEYBOARD LAYOUT REFERENCE (Expanded from SMK v15.x)]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ ª ◌ │ ՜   │ " ᵅ │ ·   │ ֏ ¤ │ %   │ &   │ /   │ ( ↻ │ )   │ = ↺ │ ՛ ՞ │ ? ¿ ┃ ⌫       ┃
    // │ º \ │ 1 | │ 2 @ │ 3 # │ 4 ◌̃ │ 5  ᷏ │ 6 ¬ │ 7 ◌̸ │ 8 ∝ │ 9  ᷘ │ 0  ͚ │ ' ՚ │ ! ¡ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ճ Ջ │ Ւ   │ Ե Է │ Ռ Ր │ Տ Թ │ Յ   │ ՈՒ   │ Ի   │ Ո Օ │ Պ Փ │ ◌̂ ◌̏ │ * ◌̛ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ճ ջ │ ւ   │ ե է │ ռ ր │ տ թ │ յ   │ ու   │ ի   │ ո օ │ պ փ │ ◌̀ [ │ + ] ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ Ա   │ Ս Շ │ Դ Ձ │ Ֆ   │ Գ Ղ │ Հ   │ Խ   │ Կ Ք │ Լ   │ ◌̑ ◌̌ │ ◌̈ ◌̋ │ Չ ◌̨ ┃      ┃
    // ┃  Lock  ┃ ա   │ ս շ │ դ ձ │ ֆ   │ գ ղ │ հ   │ խ   │ կ ք │ լ   │ ◌̧ ◌̄ │ ◌́ { │ չ } ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ > Ը │ Զ Ժ │ և   │ Ծ Ց │ Վ ◌̊ │ Բ ⌬ │ Ն   │ Մ  ͛ │ ;   │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ < ը │ զ ժ │ և   │ ծ ց │ վ ◌̆ │ բ ※ │ ն   │ մ ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    name[Group1]= "SMK-Armenian (ՃՒԵՌՏՅ)";

    key <TLDE>	{ [            masculine,   ordfeminine,            backslash,              U25CC               ] };    // U+25CC = Dotted Circle
    key <AE01>	{ [                    1,   Armenian_exclam,        bar                     ] };
    key <AE02>	{ [                    2,   quotedbl,               at,                     dead_greek          ] };
    key <AE03>	{ [                    3,   periodcentered,         numbersign              ] };
    key <AE04>	{ [                    4,   U058F,                  dead_tilde              ] };                        // U+058F = Armenian Dram ("֏")
    key <AE05>	{ [                    5,   percent,                U1DCF                   ] };                        // U+1DCF = "Letter Fusion" Dead Key
    key <AE06>	{ [                    6,   ampersand,              notsign                 ] };
    key <AE07>	{ [                    7,   slash,                  dead_longsolidusoverlay ] };
    key <AE08>	{ [                    8,   parenleft,              U221D,                  U21BB               ] };    // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [                    9,   parenright              ] };
    key <AE10>	{ [                    0,   equal,                  U035A,                  U21BA               ] };    // U+035A = "IPA Symbols" Dead Key; U+21BA = "Letter Flip" Dead Key
    key <AE11>	{ [           apostrophe,   Armenian_accent,        Armenian_apostrophe,    Armenian_question   ] };
    key <AE12>	{ [               exclam,   question,               exclamdown,             questiondown        ] };

    key <AD01>	{ [        Armenian_tche,   Armenian_TCHE,          Armenian_je,            Armenian_JE         ] };
    key <AD02>	{ [        Armenian_vyun,   Armenian_VYUN           ] };
    key <AD03>	{ [        Armenian_yech,   Armenian_YECH,          Armenian_e,             Armenian_E          ] };
    key <AD04>	{ [          Armenian_ra,   Armenian_RA,            Armenian_re,            Armenian_RE         ] };
    key <AD05>	{ [        Armenian_tyun,   Armenian_TYUN,          Armenian_to,            Armenian_TO         ] };
    key <AD06>	{ [          Armenian_hi,   Armenian_HI             ] };
    key <AD07>	{ [                 "ու",   "ՈՒ"                    ] };                                                // Lowercase Armenian Ligature U (Vo-Hyun), Uppercase Armenian Ligature U (Vo-Hyun) [Possible since libxkbcommon v1.9.0]
    key <AD08>	{ [         Armenian_ini,   Armenian_INI            ] };
    key <AD09>	{ [          Armenian_vo,   Armenian_VO,            Armenian_o,             Armenian_O          ] };
    key <AD10>	{ [          Armenian_pe,   Armenian_PE,            Armenian_pyur,          Armenian_PYUR       ] };
    key <AD11>	{ [           dead_grave,   dead_circumflex,        bracketleft,            dead_doublegrave    ] };
    key <AD12>	{ [                 plus,   asterisk,               bracketright,           dead_horn           ] };

    key <AC01>	{ [         Armenian_ayb,   Armenian_AYB            ] };
    key <AC02>	{ [          Armenian_se,   Armenian_SE,            Armenian_sha,           Armenian_SHA        ] };
    key <AC03>	{ [          Armenian_da,   Armenian_DA,            Armenian_dza,           Armenian_DZA        ] };
    key <AC04>	{ [          Armenian_fe,   Armenian_FE             ] };
    key <AC05>	{ [         Armenian_gim,   Armenian_GIM,           Armenian_ghat,          Armenian_GHAT       ] };
    key <AC06>	{ [          Armenian_ho,   Armenian_HO             ] };
    key <AC07>	{ [         Armenian_khe,   Armenian_KHE            ] };
    key <AC08>	{ [         Armenian_ken,   Armenian_KEN,           Armenian_ke,            Armenian_KE         ] };
    key <AC09>	{ [        Armenian_lyun,   Armenian_LYUN           ] };
    key <AC10>	{ [         dead_cedilla,   dead_invertedbreve,     dead_macron,            dead_caron          ] };
    key <AC11>	{ [           dead_acute,   dead_diaeresis,         braceleft,              dead_doubleacute    ] };
    key <BKSL>	{ [         Armenian_cha,   Armenian_CHA,           braceright,             dead_ogonek         ] };

    key <LSGT>	{ [                 less,   greater,                Armenian_at,            Armenian_AT         ] };
    key <AB01>	{ [          Armenian_za,   Armenian_ZA,            Armenian_zhe,           Armenian_ZHE        ] };
    key <AB02>	{ [ Armenian_ligature_ew,   Armenian_ligature_ew    ] };
    key <AB03>	{ [         Armenian_tsa,   Armenian_TSA,           Armenian_tso,           Armenian_TSO        ] };
    key <AB04>	{ [         Armenian_vev,   Armenian_VEV,           dead_breve,             dead_abovering      ] };
    key <AB05>	{ [         Armenian_ben,   Armenian_BEN,           U203B,                  U232C               ] };    // U+203B = "Punctuation Marks" Dead Key; U+232C = "Miscellaneous Symbols" Dead Key
    key <AB06>	{ [          Armenian_nu,   Armenian_NU             ] };
    key <AB07>	{ [         Armenian_men,   Armenian_MEN,           U0359,                  U035B               ] };    // U+0359 = "Hooktail" Dead Key, U+035B = "Curly Loop" Dead Key
    key <AB08>	{ [                comma,   semicolon,              dead_belowcomma         ] };
    key <AB09>	{ [               period,   colon,                  dead_abovedot,          dead_belowdot       ] };
    key <AB10>	{ [                minus,   underscore,             dead_stroke,            dead_hook           ] };

    key <SPCE>  { [                space,   space,                  nobreakspace            ] };

    // Default modifiers
    include "level3(ralt_switch)"
    include "compose(rctrl-altgr)"  // As a middle ground (feel free to change this line if you want or need to)
};

partial alphanumeric_keys
xkb_symbols "qwerty" {
    include "smk/armenian(basic)"
};

partial alphanumeric_keys
xkb_symbols "qwerty_pt" {
    // [NOTE]: This layout is based off a mixture between
    // the Portuguese and Spanish QWERTY keyboards
    // with Armenian letters as well as some
    // custom rearrangements, except with Armenian
    // letters instead of Latin ones.

    // [KEYBOARD LAYOUT REFERENCE]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ |   │ ՜   │ " ᵅ │ # · │ $ ¤ │ %   │ &   │ / ◌̸ │ ( ∝ │ ) ↻ │ = ↺ │ ՛ ՞ │ ? ¿ ┃ ⌫       ┃
    // │ \   │ 1   │ 2 @ │ 3 ֏ │ 4 § │ 5  ᷏ │ 6 ¬ │ 7 { │ 8 [ │ 9 ] │ 0 } │ ' ՚ │ ! ¡ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ Ճ Ջ │ Ւ   │ Ե Է │ Ռ Ր │ Տ Թ │ Յ   │ ՈՒ   │ Ի   │ Ո Օ │ Պ Փ │ * ◌ │ ◌̀ ◌̏ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ճ ջ │ ւ   │ ե է │ ռ ր │ տ թ │ յ   │ ու   │ ի   │ ո օ │ պ փ │ + ◌̈ │ ◌́ ◌̋ ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ Ա   │ Ս Շ │ Դ Ձ │ Ֆ   │ Գ Ղ │ Հ   │ Խ   │ Կ Ք │ Լ ◌̑ │ Չ ◌̌ │ ª  ͚ │ ◌̂ ◌̨ ┃      ┃
    // ┃  Lock  ┃ ա   │ ս շ │ դ ձ │ ֆ   │ գ ղ │ հ   │ խ   │ կ ք │ լ ◌̧ │ չ ◌̄ │ º  ᷘ │ ◌̃ ◌̛ ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ > Ը │ Զ Ժ │ և   │ Ծ Ց │ Վ ◌̊ │ Բ ⌬ │ Ն   │ Մ  ͛ │ ; ◌̓ │ : ◌̣ │ _ ◌̉ ┃              ┃
    // ┃Shift ┃ < ը │ զ ժ │ և   │ ծ ց │ վ ◌̆ │ բ ※ │ ն   │ մ ◌̡̢ │ , ◌̦ │ . ◌̇ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    include "smk/armenian(basic)"

    name[Group1]= "SMK-Armenian (Portuguese ՃՒԵՌՏՅ)";

    key <TLDE>	{ [     backslash,  bar                 ] };
    key <AE01>	{ [             1,  Armenian_exclam     ] };

    key <AE03>	{ [             3,  numbersign,        U058F,                  periodcentered          ] };     // U+058F = Armenian Dram ("֏")
    key <AE04>	{ [             4,  dollar,            section,                dead_currency           ] };
    key <AE07>	{ [             7,  slash,             braceleft,              dead_longsolidusoverlay ] };
    key <AE08>	{ [             8,  parenleft,         bracketleft,            U221D                   ] };     // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [             9,  parenright,        bracketright,           U21BB                   ] };     // U+21BB = "Arrows" Dead Key
    key <AE10>	{ [             0,  equal,             braceright,             U21BA                   ] };     // U+21BA = "Letter Flip" Dead Key

    key <AD11>	{ [          plus,  asterisk,          dead_diaeresis,         U25CC                   ] };     // U+25CC = Dotted Circle
    key <AD12>	{ [    dead_acute,  dead_grave,        dead_doubleacute,       dead_doublegrave        ] };

    key <AC10>	{ [  Armenian_cha,  Armenian_CHA,      dead_macron,            dead_caron              ] };
    key <AC11>	{ [     masculine,  ordfeminine,       U1DCF,                  U035A                   ] };     // U+1DCF = "Letter Fusion" Dead Key; U+035A = "IPA Symbols" Dead Key 
    key <BKSL>	{ [    dead_tilde,  dead_circumflex,   dead_horn,              dead_ogonek             ] };
};

