    key <AE09>	{ [      Arabic_9,  parenright,             bracketright,       U21BB                   ] };    // U+21BB = "Arrows" Dead Key
    key <AE10>	{ [      Arabic_0,  equal,                  braceright,         U21BA                   ] };    // U+21BA = "Letter Flip" Dead Key
    key <AE12>	{ [ guillemetleft,  guillemetright,         Arabic_ain,         dead_hamza              ] };

    key <AD11>	{ [          plus,  asterisk,               U25CC,              U066D                   ] };    // U+25CC = Dotted Circle; U+066D = Arabic Five-Pointed Star
    key <AD12>	{ [ dead_belowdot,  dead_belowdiaeresis,    UFBB9               ] };                            // U+FBB9 = "Arabic Triple Dot Below" Dead Key

    key <AC10>	{ [  Arabic_tcheh,  U069C,                  dead_macron,        dead_caron              ] };
    key <AC11>	{ [ dead_abovedot,  dead_diaeresis,         UFBB6               ] };                            // U+FBB6 = "Arabic Triple Dot Above" Dead Key
