    // ┃  Lock  ┃ ◌َ ◌ٰ │ س‎ ص‎ │ د‎ ض‎ │ ف‎ ڡ‎ │ گ‎ غ‎ │ ه‎   │ خ‎   │ ك‎ ک‎ │ ل‎   │ چ‎ ◌̂ │ ◌̇ ◌̈̇ │ ◌̃   ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ > ە‎ │ ژ‎ ج‎ │ ح‎   │ ځ‎   │ ڤ‎   │ ٮ‎ ⌬ │ ں‎ ݣ‎ │ م‎   │ ؛‎ ۔‎ │ : ۔‎ │ _ ـ‎ ┃              ┃
    // ┃Shift ┃ < ە‎ │ ز‎ ج‎ │ ح‎   │ څ‎   │ ڤ‎ ◌̊ │ ب‎ ※ │ ن‎ ڭ‎ │ م‎   │ ،‎ , │ . ؞‎ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
