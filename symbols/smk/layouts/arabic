// Arabic Abjad | XKB Keyboard Symbols
// [AUTHOR]: Carlos González Sanz

// [NOTE]: These keyboards are partially based upon the
// default "ara" and "es" symbols in regards to the
// physical key layout.
//
// Put this file on either ~/.config/xkb/symbols
// or in the same directory as
// the other system-wide keyboard layouts.

// [NOTE]: In order to be able to display the correct Shift ordering
// (bottom-to-top, left-to-right), many alphabetical Arabic characters
// have a Left-To-Right Mark attached to them so that each reference
// shows the correct ordering.
//
// This doesn't affect the final key assignment, because, when these layouts
// are rendered to show their underlying logical layout,
// the bottom-to-top, left-to-right ordering is used, without the previously
// aforementioned bidirectional marks.

// Default SMK-Arabic Keyboard
default partial alphanumeric_keys
xkb_symbols "basic" {
    // [NOTE]: Keys are arranged the same way as
    // in the standard Spanish QWERTY keyboard,
    // except with Arabic letters instead of
    // Latin ones.

    // [KEYBOARD LAYOUT REFERENCE (Expanded from SMK v15.x)]:
    // ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
    // │ ◌   │ ! 𐤀‎ │ "  ‎ │ ·   │ $ ۴‎ │ ٪‎ ؎‎ │ & ۽‎ │ /   │ ( ↻ │ )   │ =   │ ؟‎ ء‎ │ ع‎   ┃ ⌫       ┃
    // │ ◌ْ \ │ ١‎ | │ ٢‎ @ │ ٣‎ # │ ٤‎ ◌̃ │ ٥‎  ᷏ │ ٦‎ ¬ │ ٧‎ ؍‎ │ ٨‎ ∝ │ ٩‎ ؏‎ │ ‎٠ ↺ │ '‎ ا‎ │ ع‎ ◌ٔ ┃Backspace┃
    // ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
    // ┃       ┃ ٯ‎   │ و‎   │ ◌ٙ ¤ │ ر‎   │ ث‎ ظ‎ │ ے‎ ݐ‎ │ ◌ٌ ◌ٝ │ ◌ٍ   │ ة‎   │ پ‎   │ ◌̤ ◌̤̣ │ * ٭‎ ┃ Enter ┃
    // ┃ Tab ↹ ┃ ق‎   │ و‎   │ ◌ّ ؋‎ │ ر‎   │ ت‎ ط‎ │ ي‎ ی‎ │ ◌ُ ◌ٗ │ ◌ِ ى‎ │ ة‎   │ پ‎ ◌𐻹 │ ◌̣ [ │ + ] ┃   ⏎   ┃
    // ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
    // ┃ Caps   ┃ ◌ً ◌ٖ │ ش‎ ص‎ │ ذ‎ ض‎ │ ف‎ ڡ‎ │ گ‎ غ‎ │ ه‎   │ خ‎   │ ك‎ ڪ‎ │ ل‎   │ ڽ‎ ◌̌ │ ◌̈ ◌̈̇ │ ڜ‎   ┃      ┃
    // ┃  Lock  ┃ ◌َ ◌ٰ │ س‎ ص‎ │ د‎ ض‎ │ ف‎ ڡ‎ │ گ‎ غ‎ │ ه‎   │ خ‎   │ ك‎ ک‎ │ ل‎   │ ڽ‎ ◌̂ │ ◌̇ { │ چ‎ } ┃      ┃
    // ┣━━━━━━┳━┻───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┬─┴───┲━┻━━━━━┻━━━━━━┫
    // ┃      ┃ > ە‎ │ ژ‎ ج‎ │ ح‎   │ ځ‎   │ ڤ‎   │ ٮ‎ ⌬ │ ں‎ ݣ‎ │ م‎   │ ؛‎ ۔‎ │ : ۔‎ │ _ ـ‎ ┃              ┃
    // ┃Shift ┃ < ە‎ │ ز‎ ج‎ │ ح‎   │ څ‎   │ ڤ‎ ◌̊ │ ب‎ ※ │ ن‎ ڭ‎ │ م‎   │ ،‎ , │ . ؞‎ │ - ◌̵ ┃ Shift ⇧      ┃
    // ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴────┲┷━━━━━┷┳━━━━┻━━┳━━━━━━━┳━━━┛
    // ┃       ┃       ┃       ┃                                   ┃       ┃       ┃ ⎄     ┃
    // ┃ Ctrl  ┃ Meta  ┃  Alt  ┃                Space              ┃AltGr ⇮┃ Menu  ┃ Ctrl  ┃
    // ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

    name[Group1]= "SMK-Arabic (قوّرتي)";

    key <TLDE>	{ [      Arabic_sukun,  U25CC,                  backslash                   ] };                        // U+25CC = Dotted Circle
    key <AE01>	{ [          Arabic_1,  exclam,                 bar,                        U10900              ] };    // U+10900 = Phoenician ʾĀlep ("Phoenician Type" Dead Key)
    key <AE02>	{ [          Arabic_2,  quotedbl,               at                          ] };
    key <AE03>	{ [          Arabic_3,  periodcentered,         numbersign                  ] };
    key <AE04>	{ [          Arabic_4,  dollar,                 dead_tilde,                 U06F4               ] };    // "dead_tilde" is being reused to signify the maddah being a dead key. Additionally, U+06F4 = Extended Arabic-Indic Digit 4.
    key <AE05>	{ [          Arabic_5,  Arabic_percent,         U1DCF,                      U060E               ] };    // U+1DCF = "Letter Fusion" Dead Key; U+060E = Arabic Poetic Verse Sign
    key <AE06>	{ [          Arabic_6,  ampersand,              notsign,                    U06FD               ] };    // U+06FD = Sindhi Ampersand
    key <AE07>	{ [          Arabic_7,  slash,                  U060D                       ] };                        // U+060D = Arabic Date Separator
    key <AE08>	{ [          Arabic_8,  parenleft,              U221D,                      U21BB               ] };    // U+221D = "Logic + Math Symbols" Dead Key; U+21BB = "Arrows" Dead Key
    key <AE09>	{ [          Arabic_9,  parenright,             U060F                       ] };                        // U+060F = Arabic Sign Misra
    key <AE10>	{ [          Arabic_0,  equal,                  U21BA                       ] };                        // U+21BA = "Letter Flip" Dead Key
    key <AE11>	{ [        apostrophe,  Arabic_question_mark,   Arabic_alef,                Arabic_hamza        ] };
    key <AE12>	{ [        Arabic_ain,  Arabic_ain,             dead_hamza                  ] };

    key <AD01>	{ [        Arabic_qaf,  U066F                   ] };                                                    // U+066F = Dotless Qāf
    key <AD02>	{ [        Arabic_waw,  Arabic_waw              ] };
    key <AD03>	{ [     Arabic_shadda,  U0659,                  U060B,                      dead_currency       ] };    // U+0659 = Zwarakay (Pashto [ə]); U+060B = Afghani Sign
    key <AD04>	{ [         Arabic_ra,  Arabic_ra               ] };
    key <AD05>	{ [        Arabic_teh,  Arabic_theh,            Arabic_tah,                 Arabic_zah          ] };
    key <AD06>	{ [        Arabic_yeh,  U06D2,                  Farsi_yeh,                  U0750               ] };    // U+06D2 = Baṛī Ye; U+0750 = Fula/Fulfulde [ˀj]
    key <AD07>	{ [      Arabic_damma,  Arabic_dammatan,        U0657,                      U065D               ] };    // U+0657 = Inverted Ḍammah; U+065D = Reversed Ḍammah
    key <AD08>	{ [      Arabic_kasra,  Arabic_kasratan,        Arabic_alefmaksura          ] };
    key <AD09>	{ [ Arabic_tehmarbuta,  Arabic_tehmarbuta       ] };
    key <AD10>	{ [        Arabic_peh,  Arabic_peh,             U10EF9                      ] };                        // U+10EF9 = "Arabic Crown" Dead Key
    key <AD11>	{ [     dead_belowdot,  dead_belowdiaeresis,    bracketleft,                UFBB9               ] };    // U+FBB9 = "Arabic Triple Dot Below" Dead Key
    key <AD12>	{ [              plus,  asterisk,               bracketright,               U066D               ] };    // U+066D = Arabic Five-Pointed Star

    key <AC01>	{ [      Arabic_fatha,  Arabic_fathatan,        Arabic_superscript_alef,    U0656               ] };    // U+0656 = Subscript ʾAlif
    key <AC02>	{ [       Arabic_seen,  Arabic_sheen,           Arabic_sad,                 Arabic_sad          ] };
    key <AC03>	{ [        Arabic_dal,  Arabic_thal,            Arabic_dad,                 Arabic_dad          ] };
    key <AC04>	{ [        Arabic_feh,  Arabic_feh,             U06A1,                      U06A1               ] };    // U+06A1 = Dotless Fāʾ
    key <AC05>	{ [        Arabic_gaf,  Arabic_gaf,             Arabic_ghain,               Arabic_ghain        ] };
    key <AC06>	{ [         Arabic_ha,  Arabic_ha               ] };
    key <AC07>	{ [       Arabic_khah,  Arabic_khah             ] };
    key <AC08>	{ [        Arabic_kaf,  Arabic_kaf,             Arabic_keheh,               U06AA               ] };    // U+06AA = Swash Kāf
    key <AC09>	{ [        Arabic_lam,  Arabic_lam              ] };
    key <AC10>	{ [             U06BD,  U06BD,                  dead_circumflex,            dead_caron          ] };    // U+06BD = Jawi Nya
    key <AC11>	{ [     dead_abovedot,  dead_diaeresis,         braceleft,                  UFBB6               ] };    // U+FBB6 = "Arabic Triple Dot Above" Dead Key
    key <BKSL>	{ [      Arabic_tcheh,  U069C,                  braceright                  ] };                        // U+069C = Maghrebi Če

    key <LSGT>	{ [              less,  greater,                U06D5,                      U06D5               ] };    // U+06D5 = Arabic Ae
    key <AB01>	{ [       Arabic_zain,  Arabic_jeh,             Arabic_jeem,                Arabic_jeem         ] };
    key <AB02>	{ [        Arabic_hah,  Arabic_hah              ] };
    key <AB03>	{ [             U0685,  U0681                   ] };                                                    // U+0685 = Pashto Tsē; U+0681 = Pashto Dzē
    key <AB04>	{ [        Arabic_veh,  Arabic_veh,             dead_abovering              ] };
    key <AB05>	{ [        Arabic_beh,  U066E,                  U203B,                      U232C               ] };    // U+066E = Dotless Bāʾ; U+203B = "Punctuation Marks" Dead Key; U+232C = "Miscellaneous Symbols" Dead Key
    key <AB06>	{ [       Arabic_noon,  Arabic_noon_ghunna,     U06AD,                      U0763               ] };    // U+06AD = Ngaf; U+0763 = Maghrebi Gāf
    key <AB07>	{ [       Arabic_meem,  Arabic_meem             ] };
    key <AB08>	{ [      Arabic_comma,  Arabic_semicolon,       comma,                      Arabic_fullstop     ] };
    key <AB09>	{ [            period,  colon,                  U061E,                      Arabic_fullstop     ] };    // U+061E = West African Triple Dot Mark
    key <AB10>	{ [             minus,  underscore,             dead_stroke,                Arabic_tatweel      ] };

    key <SPCE>  { [             space,  space,                  nobreakspace                ] };

    // Default modifiers
    include "level3(ralt_switch)"
    include "compose(rctrl-altgr)"  // As a middle ground (feel free to change this line if you want or need to)
};

partial alphanumeric_keys
xkb_symbols "qwerty" {
    include "smk/arabic(basic)"
};

