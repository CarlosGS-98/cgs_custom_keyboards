<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xkbConfigRegistry SYSTEM "xkb.dtd">
<xkbConfigRegistry version="1.1">
  <!-- Add these rules to both "base.xml" and "evdev.xml"
       or, if you prefer, to "~/.config/xkb/rules/evdev.xml" -->
  <layoutList>
    <!-- (...) -->
    <layout>
      <configItem>
        <name>smk/armenian</name>
        <!-- Keyboard indicator for Skorpian Master Keyboard (Armenian Alphabet) layouts -->
        <shortDescription><!-- Insert locale name ("es", "fr", "de", "us", etc.) --></shortDescription>
        <description>Skorpian Master Keyboard v16.7.5 (Armenian Alphabet)</description>
        <countryList>
          <iso3166Id><!-- Insert ISO-3166-1 Code --></iso3166Id>
        </countryList>
        <languageList>
          <iso639Id>smk</iso639Id>
        </languageList>
      </configItem>

      <variantList>
        <variant>
          <configItem>
            <name>qwerty</name>
            <description>SMK-Armenian (ՃՒԵՌՏՅ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>qwerty_pt</name>
            <description>SMK-Armenian (Portuguese ՃՒԵՌՏՅ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>qwerty_us</name>
            <description>SMK-Armenian (US ՃՒԵՌՏՅ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>qwertz</name>
            <description>SMK-Armenian (ՃՒԵՌՏԶ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>latam</name>
            <description>SMK-Armenian (Latam ՃՒԵՌՏՅ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>dvorak</name>
            <description>SMK-Armenian (Դվորժակ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>colemak</name>
            <description>SMK-Armenian (Քոլմաք)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>jcuken</name>
            <description>SMK-Armenian (ԽԾՈՒԿԵՆ)</description>
          </configItem>
        </variant>
        <!-- (...) -->
      </variantList>
    </layout>
    <!-- (...) -->
  </layoutList>
  <!-- (...) -->
</xkbConfigRegistry>
