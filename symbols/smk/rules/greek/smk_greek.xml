<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xkbConfigRegistry SYSTEM "xkb.dtd">
<xkbConfigRegistry version="1.1">
  <!-- Add these rules to both "base.xml" and "evdev.xml"
       or, if you prefer, to "~/.config/xkb/rules/evdev.xml" -->
  <layoutList>
    <!-- (...) -->
    <layout>
      <configItem>
        <name>smk/greek</name>
        <!-- Keyboard indicator for Skorpian Master Keyboard (Greek Script) layouts -->
        <shortDescription><!-- Insert locale name ("es", "fr", "de", "us", etc.) --></shortDescription>
        <description>Skorpian Master Keyboard v16.0 (Greek Alphabet)</description>
        <countryList>
          <iso3166Id><!-- Insert ISO-3166-1 Code --></iso3166Id>
        </countryList>
        <languageList>
          <iso639Id>smk</iso639Id>
        </languageList>
      </configItem>

      <variantList>
        <variant>
          <configItem>
            <name>qwerty</name>
            <description>SMK-Greek (ϘϜΕΡΤͿ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>qwerty_pt</name>
            <description>SMK-Greek (Portuguese ϘϜΕΡΤͿ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>qwerty_el</name>
            <description>SMK-Greek (Greek+US ϘϜΕΡΤͿ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>qwertz</name>
            <description>SMK-Greek (ϘϜΕΡΤΖ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>dvorak</name>
            <description>SMK-Greek (Ντβόρακ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>colemak</name>
            <description>SMK-Greek (Κόλμακ)</description>
          </configItem>
        </variant>
        <variant>
          <configItem>
            <name>jcuken</name>
            <description>SMK-Greek (ΧϺΥΚΕΝ)</description>
          </configItem>
        </variant>
        <!-- (...) -->
      </variantList>
    </layout>
    <!-- (...) -->
  </layoutList>
  <!-- (...) -->
</xkbConfigRegistry>
