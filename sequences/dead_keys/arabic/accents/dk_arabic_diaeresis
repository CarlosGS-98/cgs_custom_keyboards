<dead_diaeresis> <Arabic_kaf>   : "ݿ"
<dead_diaeresis> <Arabic_keheh> : "ػ"
<dead_diaeresis> <Arabic_gaf>   : "ڱ"   # Ngē/Ŋē
<dead_diaeresis> <Arabic_ha>    : "ة"   # Tāʾ Marbūṭa
<dead_diaeresis> <Farsi_yeh>    : "ؾ"


# Doubly stacked diaeresis above combinations
<dead_diaeresis> <2> <U066E>        : "ٿ"
<dead_diaeresis> <2> <Arabic_dal>   : "ڐ"
<dead_diaeresis> <2> <Arabic_ra>    : "ڙ"
<dead_diaeresis> <2> <U06A1>        : "ڦ"   # Peheh


# Vertical diaeresis above combinations
<dead_diaeresis> <bar> <U066E>          : "ٺ"   # Ṭhē
<dead_diaeresis> <bar> <Arabic_hah>     : "ڂ"
<dead_diaeresis> <bar> <Arabic_ra>      : "ݫ"
<dead_diaeresis> <bar> <Arabic_seen>    : "ݭ"
<dead_diaeresis> <bar> <Arabic_ain>     : "ݟ"


