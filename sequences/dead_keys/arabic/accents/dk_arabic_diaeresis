# Basic precomposed letter combinations
<dead_diaeresis> <U066E>        : "ت"   # Tāʾ
<dead_diaeresis> <Arabic_teh>   : "ٿ"
<dead_diaeresis> <Arabic_jeem>  : "ࢢ"
<dead_diaeresis> <Arabic_hah>   : "ݗ"
<dead_diaeresis> <Arabic_dal>   : "ڌ"   # Dhal
