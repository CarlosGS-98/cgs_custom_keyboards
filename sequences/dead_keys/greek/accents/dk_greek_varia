<dead_grave> <Greek_UPSILON>    : "Ὺ"
<dead_grave> <Greek_upsilon>    : "ὺ"
<dead_grave> <Greek_OMEGA>      : "Ὼ"
<dead_grave> <Greek_omega>      : "ὼ"


