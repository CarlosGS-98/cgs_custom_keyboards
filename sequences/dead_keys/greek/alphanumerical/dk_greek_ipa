# IPA Sounds (Alphabetical)
<U035A> <Greek_DELTA> <Greek_DELTA>     : "ʭ"   # Bidental percussive
<U035A> <Greek_delta> <Greek_delta>     : "ʭ"   # Bidental percussive
<U035A> <Greek_EPSILON>                 : "Ə"   # Schwa
<U035A> <Greek_epsilon>                 : "ə"   # Schwa
<U035A> <minus> <Greek_EPSILON>         : "ɘ"   # Close-mid central unrounded vowel
<U035A> <minus> <Greek_epsilon>         : "ɘ"   # Close-mid central unrounded vowel
<U035A> <Greek_GAMMA>                   : "Ɡ"   # Single-storey G
<U035A> <Greek_gamma>                   : "ɡ"   # Single-storey G
<U035A> <U0370>                         : "ɧ"   # "IPA Symbols" + Ͱ (Heta) = SJ-Sound
<U035A> <U0371>                         : "ɧ"   # "IPA Symbols" + ͱ (Heta) = SJ-Sound
<U035A> <Greek_IOTA>                    : "Ɪ"   # Near-close near-front unrounded vowel
<U035A> <Greek_iota>                    : "ɪ"   # Near-close near-front unrounded vowel
<U035A> <Greek_CHI>                     : "ɟ"   # Barred Dotless J
<U035A> <Greek_chi>                     : "ɟ"   # Barred Dotless J
<U035A> <Greek_LAMBDA>                  : "𝼈"   # Retroflex lateral flap
<U035A> <Greek_lambda>                  : "ɺ"   # Lateral flap
<U035A> <Greek_MU>                      : "ɰ"   # Voiced velar approximant
<U035A> <Greek_mu>                      : "ɰ"   # Voiced velar approximant
<U035A> <Greek_OMICRON>                 : "Ɔ"   # Open O
<U035A> <Greek_omicron>                 : "ɔ"   # Open O
<U035A> <Greek_OMEGA>                   : "Ɤ"   # Ram's Horn
<U035A> <Greek_omega>                   : "ɤ"   # Ram's Horn
<U035A> <Greek_RHO>                     : "ɻ"   # Voiced retroflex approximant
<U035A> <Greek_rho>                     : "ɹ"   # Voiced alveolar approximant
<U035A> <minus> <Greek_RHO>             : "ꭅ"   # Teuthonista [ɾ]
<U035A> <minus> <Greek_rho>             : "ꭅ"   # Teuthonista [ɾ]
<U035A> <underscore> <Greek_RHO>        : "ɾ"   # Voiced alveolar flap
<U035A> <underscore> <Greek_rho>        : "ɾ"   # Voiced alveolar flap
<U035A> <Greek_SIGMA>                   : "Ʃ"   # Esh
<U035A> <Greek_sigma>                   : "ʃ"   # Esh
<U035A> <U0376>                         : "ⱱ"   # "IPA Symbols" + Ͷ (Pamphylian Digamma) = Labiodental flap
<U035A> <U0377>                         : "ⱱ"   # "IPA Symbols" + ͷ (Pamphylian Digamma) = Labiodental flap
<U035A> <U03DC> <U03DC>                 : "ʬ"   # "IPA Symbols" + Ϝ (Greek Digamma) = Bilabial percussive
<U035A> <U03DD> <U03DD>                 : "ʬ"   # "IPA Symbols" + ϝ (Greek Digamma) = Bilabial percussive
<U035A> <Greek_ZETA>                    : "Ʒ"   # Ezh
<U035A> <Greek_zeta>                    : "ʒ"   # Ezh


