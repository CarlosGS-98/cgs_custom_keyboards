# Common Dead Keys | Tilde Rules
# [AUTHOR]: Carlos González Sanz
#
# > The purpose of this file is to store default
# > Compose rules for the tilde/virgulilla/perispomeni
# > across multiple writing systems.
#

# Basic combinations
<dead_tilde> <space>            : "̃"    # Combining tilde
<dead_tilde> <at> <space>       : "ٓ"    # Maddah above
<dead_tilde> <at> <2>           : "࢞"    # Doubled maddah
<dead_tilde> <at> <Arabic_2>    : "࢞"    # Doubled maddah
<dead_tilde> <at> <at>          : "࢟"    # Maddah over maddah
<dead_tilde> <at> <minus>       : "࢜"    # Maddah Waajid
<dead_tilde> <dead_tilde>       : "~"   # Regular spacing tilde
<dead_tilde> <less>             : "̰"    # Combining tilde below
<dead_tilde> <greater>          : "˜"   # Small tilde
<dead_tilde> <comma>            : "͂"    # Combining Greek perispomeni
<dead_tilde> <semicolon>        : "҃"    # Combining Cyrillic titlo


# Rules from "<U0334>"  ("dead_middletilde")
<dead_tilde> <minus> <space>    : "̴"    # Combining middle tilde


# Rules from "<dead_belowtilde>"
<dead_tilde> <underscore> <space>   : "̰"    # Combining tilde below

