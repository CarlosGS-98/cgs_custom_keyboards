# Common Dead Keys | Dot Above Rules
# [AUTHOR]: Carlos González Sanz
#
# > The purpose of this file is to store default
# > Compose rules for the diacritical dot above
# > across multiple writing systems.
#

# Basic combinations
<dead_abovedot> <space>         : "̇"    # Combining dot above
<dead_abovedot> <dead_abovedot> : "˙"   # Regular spacing dot above
<dead_abovedot> <less>          : "᷸"    # Combining dot above left
<dead_abovedot> <greater>       : "͘"    # Combining dot above right


# Arabic extensions
<dead_abovedot> <at> <space>                    : "﮲"    # Arabic dot above
<dead_abovedot> <at> <1>                        : "࣪"    # Arabic tone one dot above
<dead_abovedot> <at> <period> <space>           : "ࢇ"    # Arabic baseline round dot
<dead_abovedot> <at> <periodcentered> <space>   : "࢈"    # Arabic raised round dot

