# Latin Alphabet | IPA Symbols Rules
# [AUTHOR]: Carlos González Sanz
#
# > The purpose of this file is to store default
# > Compose rules for typing phonetic symbols
# > mainly found in the IPA chart (including some
# > symbols from extIPA, UPA, etc.)
# > through alphabetical means.
#
# [Main source]: https://en.wikipedia.org/wiki/Phonetic_symbols_in_Unicode
#

# IPA Sounds (Alphabetical)
<U035A> <C>                             : "ʗ"   # Stretched C
<U035A> <c>                             : "ʗ"   # Stretched C
<U035A> <D> <D>                         : "ʭ"   # Bidental percussive
<U035A> <d> <d>                         : "ʭ"   # Bidental percussive
<U035A> <E>                             : "Ə"   # Schwa
<U035A> <e>                             : "ə"   # Schwa
<U035A> <minus> <E>                     : "ɘ"   # Close-mid central unrounded vowel
<U035A> <minus> <e>                     : "ɘ"   # Close-mid central unrounded vowel
<U035A> <G>                             : "Ɡ"   # Single-storey G
<U035A> <g>                             : "ɡ"   # Single-storey G
<U035A> <H>                             : "ɧ"   # SJ-Sound
<U035A> <h>                             : "ɧ"   # SJ-Sound
<U035A> <I>                             : "Ɪ"   # Near-close near-front unrounded vowel
<U035A> <i>                             : "ɪ"   # Near-close near-front unrounded vowel
<U035A> <J>                             : "ɟ"   # Barred Dotless J
<U035A> <j>                             : "ɟ"   # Barred Dotless J
<U035A> <L>                             : "𝼈"   # Retroflex lateral flap
<U035A> <l>                             : "ɺ"   # Lateral flap
<U035A> <M>                             : "ɰ"   # Voiced velar approximant
<U035A> <m>                             : "ɰ"   # Voiced velar approximant
<U035A> <O>                             : "Ɔ"   # Open O
<U035A> <o>                             : "ɔ"   # Open O
<U035A> <Oslash>                        : "Ɤ"   # Ram's Horn
<U035A> <oslash>                        : "ɤ"   # Ram's Horn
<U035A> <R>                             : "ɻ"   # Voiced retroflex approximant
<U035A> <r>                             : "ɹ"   # Voiced alveolar approximant
<U035A> <minus> <R>                     : "ꭅ"   # Teuthonista [ɾ]
<U035A> <minus> <r>                     : "ꭅ"   # Teuthonista [ɾ]
<U035A> <underscore> <R>                : "ɾ"   # Voiced alveolar flap
<U035A> <underscore> <r>                : "ɾ"   # Voiced alveolar flap
<U035A> <S>                             : "Ʃ"   # Esh
<U035A> <s>                             : "ʃ"   # Esh
<U035A> <minus> <s>                     : "ʄ"   # Barred Esh
<U035A> <V>                             : "ⱱ"   # Labiodental flap
<U035A> <v>                             : "ⱱ"   # Labiodental flap
<U035A> <W> <W>                         : "ʬ"   # Bilabial percussive
<U035A> <w> <w>                         : "ʬ"   # Bilabial percussive
<U035A> <Z>                             : "Ʒ"   # Ezh
<U035A> <z>                             : "ʒ"   # Ezh
<U035A> <U0241> <space>                 : "ʔ"   # Ɂ (Capital Glottal Stop) + IPA Key
<U035A> <U0242> <space>                 : "ʔ"   # ɂ (Small Glottal Stop) + IPA Key
<U035A> <U0241> <minus>                 : "ʡ"   # Ɂ (Capital Glottal Stop) + "-" + IPA Key
<U035A> <U0242> <minus>                 : "ʡ"   # ɂ (Small Glottal Stop) + "-" + IPA Key
<U035A> <U21BA> <U0241>                 : "ʖ"   # Ɂ (Capital Glottal Stop) + "Letter Flip" Dead Key + IPA Key = Inverted Glottal Stop
<U035A> <U21BA> <U0242>                 : "ʖ"   # ɂ (Small Glottal Stop) + "Letter Flip" Dead Key + IPA Key = Inverted Glottal Stop
<U035A> <UA7CE> <space>                 : "ʕ"   # ꟎ (Capital Pharyngeal Voiced Fricative) + " " + IPA Key
<U035A> <UA7CF> <space>                 : "ʕ"   # ꟏ (Small Pharyngeal Voiced Fricative) + " " + IPA Key
<U035A> <UA7CE> <minus>                 : "ʢ"   # ꟎ (Capital Pharyngeal Voiced Fricative) + "-" + IPA Key
<U035A> <UA7CF> <minus>                 : "ʢ"   # ꟏ (Small Pharyngeal Voiced Fricative) + "-" + IPA Key
<U035A> <U0241> <underscore> <space>    : "ʕ"   # Ɂ (Capital Glottal Stop) + " " + IPA Key
<U035A> <U0242> <underscore> <space>    : "ʕ"   # ɂ (Small Glottal Stop) + " " + IPA Key
<U035A> <U0241> <underscore> <minus>    : "ʢ"   # Ɂ (Capital Glottal Stop) + "-" + IPA Key
<U035A> <U0242> <underscore> <minus>    : "ʢ"   # ɂ (Small Glottal Stop) + "-" + IPA Key


