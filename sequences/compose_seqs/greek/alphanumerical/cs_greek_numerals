# Greek Alphabet | Numerals Rules
# [AUTHOR]: Carlos González Sanz
#
# > The purpose of this file is to store default
# > Compose rules for typing cross-linguistic numeral symbols
# > that can be input with alphabetical Greek characters
# > by using the "Logic + Math Symbols" dead key (<U221D>)
# > in conjunction with the Compose Key (<Multi_key>).
#
# [Main source]: https://en.wikipedia.org/wiki/Numerals_in_Unicode
#

# Roman Numerals
#
# [NOTE]: All the rules listed below terminate with a space (<space>)
#         to allow to type all Roman numeral signs found in Unicode.
#
<Multi_key> <U221D> <Greek_IOTA> <space>                                                        : "Ⅰ"    # Roman 1
<Multi_key> <U221D> <Greek_iota> <space>                                                        : "ⅰ"    # Roman 1
<Multi_key> <U221D> <Greek_IOTA> <Greek_IOTA> <space>                                           : "Ⅱ"    # Roman 2
<Multi_key> <U221D> <Greek_iota> <Greek_iota> <space>                                           : "ⅱ"    # Roman 2
<Multi_key> <U221D> <Greek_IOTA> <Greek_IOTA> <Greek_IOTA> <space>                              : "Ⅲ"    # Roman 3
<Multi_key> <U221D> <Greek_iota> <Greek_iota> <Greek_iota> <space>                              : "ⅲ"    # Roman 3
<Multi_key> <U221D> <Greek_IOTA> <U0376> <space>                                                : "Ⅳ"    # Roman 4
<Multi_key> <U221D> <Greek_iota> <U0377> <space>                                                : "ⅳ"    # Roman 4
<Multi_key> <U221D> <U0376> <space>                                                             : "Ⅴ"    # Roman 5
<Multi_key> <U221D> <U0377> <space>                                                             : "ⅴ"    # Roman 5
<Multi_key> <U221D> <U0376> <Greek_IOTA> <space>                                                : "Ⅵ"    # Roman 6
<Multi_key> <U221D> <U0377> <Greek_iota> <space>                                                : "ⅵ"    # Roman 6
<Multi_key> <U221D> <Ccedilla> <space>                                                          : "ↅ"    # Alternate Roman 6
<Multi_key> <U221D> <ccedilla> <space>                                                          : "ↅ"    # Alternate Roman 6
<Multi_key> <U221D> <dead_cedilla> <U03FA> <space>                                              : "ↅ"    # Alternate Roman 6
<Multi_key> <U221D> <dead_cedilla> <U03FB> <space>                                              : "ↅ"    # Alternate Roman 6
<Multi_key> <U221D> <U0376> <Greek_IOTA> <Greek_IOTA> <space>                                   : "Ⅶ"    # Roman 7
<Multi_key> <U221D> <U0377> <Greek_iota> <Greek_iota> <space>                                   : "ⅶ"    # Roman 7
<Multi_key> <U221D> <U0376> <Greek_IOTA> <Greek_IOTA> <Greek_IOTA> <space>                      : "Ⅷ"    # Roman 8
<Multi_key> <U221D> <U0377> <Greek_iota> <Greek_iota> <Greek_iota> <space>                      : "ⅷ"    # Roman 8
<Multi_key> <U221D> <Greek_IOTA> <Greek_XI> <space>                                             : "Ⅸ"    # Roman 9
<Multi_key> <U221D> <Greek_iota> <Greek_xi> <space>                                             : "ⅸ"    # Roman 9
<Multi_key> <U221D> <Greek_XI> <space>                                                          : "Ⅹ"    # Roman 10
<Multi_key> <U221D> <Greek_xi> <space>                                                          : "ⅹ"    # Roman 10
<Multi_key> <U221D> <Greek_XI> <Greek_IOTA> <space>                                             : "Ⅺ"   # Roman 11
<Multi_key> <U221D> <Greek_xi> <Greek_iota> <space>                                             : "ⅺ"   # Roman 11
<Multi_key> <U221D> <Greek_XI> <Greek_IOTA> <Greek_IOTA> <space>                                : "Ⅻ"   # Roman 12
<Multi_key> <U221D> <Greek_xi> <Greek_iota> <Greek_iota> <space>                                : "ⅻ"   # Roman 12
<Multi_key> <U221D> <Greek_LAMBDA> <space>                                                      : "Ⅼ"    # Roman 50
<Multi_key> <U221D> <Greek_lambda> <space>                                                      : "ⅼ"    # Roman 50
<Multi_key> <U221D> <Greek_TAU> <space>                                                         : "ↆ"    # Alternate Roman 50
<Multi_key> <U221D> <Greek_tau> <space>                                                         : "ↆ"    # Alternate Roman 50
<Multi_key> <U221D> <U03FA> <space>                                                             : "Ⅽ"    # Roman 100
<Multi_key> <U221D> <U03FB> <space>                                                             : "ⅽ"    # Roman 100
<Multi_key> <U221D> <U21BA> <U03FA> <space>                                                     : "Ↄ"    # Alternate Roman 100
<Multi_key> <U221D> <U21BA> <U03FB> <space>                                                     : "ↄ"    # Alternate Roman 100
<Multi_key> <U221D> <Greek_DELTA> <space>                                                       : "Ⅾ"    # Roman 500
<Multi_key> <U221D> <Greek_delta> <space>                                                       : "ⅾ"    # Roman 500
<Multi_key> <U221D> <Greek_MU> <space>                                                          : "Ⅿ"    # Roman 1000
<Multi_key> <U221D> <Greek_mu> <space>                                                          : "ⅿ"    # Roman 1000
<Multi_key> <U221D> <U03FA> <Greek_DELTA> <space>                                               : "ↀ"   # Alternate Roman 1000
<Multi_key> <U221D> <U03FB> <Greek_delta> <space>                                               : "ↀ"   # Alternate Roman 1000
<Multi_key> <U221D> <Greek_DELTA> <Greek_DELTA> <space>                                         : "ↁ"    # Roman 5000
<Multi_key> <U221D> <Greek_delta> <Greek_delta> <space>                                         : "ↁ"    # Roman 5000
<Multi_key> <U221D> <U03FA> <U03FA> <Greek_DELTA> <Greek_DELTA> <space>                         : "ↂ"   # Roman 10000
<Multi_key> <U221D> <U03FB> <U03FB> <Greek_delta> <Greek_delta> <space>                         : "ↂ"   # Roman 10000
<Multi_key> <U221D> <Greek_DELTA> <Greek_DELTA> <Greek_DELTA> <space>                           : "ↇ"    # Roman 50000
<Multi_key> <U221D> <Greek_delta> <Greek_delta> <Greek_delta> <space>                           : "ↇ"    # Roman 50000
<Multi_key> <U221D> <U03FA> <U03FA> <U03FA> <Greek_DELTA> <Greek_DELTA> <Greek_DELTA> <space>   : "ↈ"   # Roman 100000
<Multi_key> <U221D> <U03FB> <U03FB> <U03FB> <Greek_delta> <Greek_delta> <Greek_delta> <space>   : "ↈ"   # Roman 100000

