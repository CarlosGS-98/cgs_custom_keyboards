# Cyrillic Alphabet | Numerals Rules
# [AUTHOR]: Carlos González Sanz
#
# > The purpose of this file is to store default
# > Compose rules for typing cross-linguistic numeral symbols
# > that can be input with alphabetical Cyrillic characters
# > by using the "Logic + Math Symbols" dead key (<U221D>)
# > in conjunction with the Compose Key (<Multi_key>).
#
# [Main source]: https://en.wikipedia.org/wiki/Numerals_in_Unicode
#

# Roman Numerals
#
# [NOTE]: All the rules listed below terminate with a space (<space>)
#         to allow to type all Roman numeral signs found in Unicode.
#
<Multi_key> <U221D> <Cyrillic_I> <space>                                                                            : "Ⅰ"    # Roman 1
<Multi_key> <U221D> <Cyrillic_i> <space>                                                                            : "ⅰ"    # Roman 1
<Multi_key> <U221D> <Ukrainian_I> <space>                                                                           : "Ⅰ"    # Roman 1
<Multi_key> <U221D> <Ukrainian_i> <space>                                                                           : "ⅰ"    # Roman 1
<Multi_key> <U221D> <Cyrillic_I> <Cyrillic_I> <space>                                                               : "Ⅱ"    # Roman 2
<Multi_key> <U221D> <Cyrillic_i> <Cyrillic_i> <space>                                                               : "ⅱ"    # Roman 2
<Multi_key> <U221D> <Ukrainian_I> <Ukrainian_I> <space>                                                             : "Ⅱ"    # Roman 2
<Multi_key> <U221D> <Ukrainian_i> <Ukrainian_i> <space>                                                             : "ⅱ"    # Roman 2
<Multi_key> <U221D> <Cyrillic_I> <Cyrillic_I> <Cyrillic_I> <space>                                                  : "Ⅲ"    # Roman 3
<Multi_key> <U221D> <Cyrillic_i> <Cyrillic_i> <Cyrillic_i> <space>                                                  : "ⅲ"    # Roman 3
<Multi_key> <U221D> <Ukrainian_I> <Ukrainian_I> <Ukrainian_I> <space>                                               : "Ⅲ"    # Roman 3
<Multi_key> <U221D> <Ukrainian_i> <Ukrainian_i> <Ukrainian_i> <space>                                               : "ⅲ"    # Roman 3
<Multi_key> <U221D> <Cyrillic_I> <Cyrillic_VE> <space>                                                              : "Ⅳ"    # Roman 4
<Multi_key> <U221D> <Cyrillic_i> <Cyrillic_ve> <space>                                                              : "ⅳ"    # Roman 4
<Multi_key> <U221D> <Ukrainian_I> <Cyrillic_VE> <space>                                                             : "Ⅳ"    # Roman 4
<Multi_key> <U221D> <Ukrainian_i> <Cyrillic_ve> <space>                                                             : "ⅳ"    # Roman 4
<Multi_key> <U221D> <Cyrillic_VE> <space>                                                                           : "Ⅴ"    # Roman 5
<Multi_key> <U221D> <Cyrillic_ve> <space>                                                                           : "ⅴ"    # Roman 5
<Multi_key> <U221D> <Cyrillic_VE> <Cyrillic_I> <space>                                                              : "Ⅵ"    # Roman 6
<Multi_key> <U221D> <Cyrillic_ve> <Cyrillic_i> <space>                                                              : "ⅵ"    # Roman 6
<Multi_key> <U221D> <Cyrillic_VE> <Ukrainian_I> <space>                                                             : "Ⅵ"    # Roman 6
<Multi_key> <U221D> <Cyrillic_ve> <Ukrainian_i> <space>                                                             : "ⅵ"    # Roman 6
<Multi_key> <U221D> <Cyrillic_CHE> <space>                                                                          : "ↅ"    # Alternate Roman 6
<Multi_key> <U221D> <Cyrillic_che> <space>                                                                          : "ↅ"    # Alternate Roman 6
<Multi_key> <U221D> <Cyrillic_VE> <Cyrillic_I> <Cyrillic_I> <space>                                                 : "Ⅶ"    # Roman 7
<Multi_key> <U221D> <Cyrillic_ve> <Cyrillic_i> <Cyrillic_i> <space>                                                 : "ⅶ"    # Roman 7
<Multi_key> <U221D> <Cyrillic_VE> <Ukrainian_I> <Ukrainian_I> <space>                                               : "Ⅶ"    # Roman 7
<Multi_key> <U221D> <Cyrillic_ve> <Ukrainian_i> <Ukrainian_i> <space>                                               : "ⅶ"    # Roman 7
<Multi_key> <U221D> <Cyrillic_VE> <Cyrillic_I> <Cyrillic_I> <Cyrillic_I> <space>                                    : "Ⅷ"    # Roman 8
<Multi_key> <U221D> <Cyrillic_ve> <Cyrillic_i> <Cyrillic_i> <Cyrillic_i> <space>                                    : "ⅷ"    # Roman 8
<Multi_key> <U221D> <Cyrillic_VE> <Ukrainian_I> <Ukrainian_I> <Ukrainian_I> <space>                                 : "Ⅷ"    # Roman 8
<Multi_key> <U221D> <Cyrillic_ve> <Ukrainian_i> <Ukrainian_i> <Ukrainian_i> <space>                                 : "ⅷ"    # Roman 8
<Multi_key> <U221D> <Cyrillic_I> <Cyrillic_HA> <space>                                                              : "Ⅸ"    # Roman 9
<Multi_key> <U221D> <Cyrillic_i> <Cyrillic_ha> <space>                                                              : "ⅸ"    # Roman 9
<Multi_key> <U221D> <Ukrainian_I> <Cyrillic_HA> <space>                                                             : "Ⅸ"    # Roman 9
<Multi_key> <U221D> <Ukrainian_i> <Cyrillic_ha> <space>                                                             : "ⅸ"    # Roman 9
<Multi_key> <U221D> <Cyrillic_HA> <space>                                                                           : "Ⅹ"    # Roman 10
<Multi_key> <U221D> <Cyrillic_ha> <space>                                                                           : "ⅹ"    # Roman 10
<Multi_key> <U221D> <Cyrillic_HA> <Cyrillic_I> <space>                                                              : "Ⅺ"   # Roman 11
<Multi_key> <U221D> <Cyrillic_ha> <Cyrillic_i> <space>                                                              : "ⅺ"   # Roman 11
<Multi_key> <U221D> <Cyrillic_HA> <Ukrainian_I> <space>                                                             : "Ⅺ"   # Roman 11
<Multi_key> <U221D> <Cyrillic_ha> <Ukrainian_i> <space>                                                             : "ⅺ"   # Roman 11
<Multi_key> <U221D> <Cyrillic_HA> <Cyrillic_I> <Cyrillic_I> <space>                                                 : "Ⅻ"   # Roman 12
<Multi_key> <U221D> <Cyrillic_ha> <Cyrillic_i> <Cyrillic_i> <space>                                                 : "ⅻ"   # Roman 12
<Multi_key> <U221D> <Cyrillic_HA> <Ukrainian_I> <Ukrainian_I> <space>                                               : "Ⅻ"   # Roman 12
<Multi_key> <U221D> <Cyrillic_ha> <Ukrainian_i> <Ukrainian_i> <space>                                               : "ⅻ"   # Roman 12
<Multi_key> <U221D> <Cyrillic_EL> <space>                                                                           : "Ⅼ"    # Roman 50
<Multi_key> <U221D> <Cyrillic_el> <space>                                                                           : "ⅼ"    # Roman 50
<Multi_key> <U221D> <Cyrillic_TE> <space>                                                                           : "ↆ"    # Alternate Roman 50
<Multi_key> <U221D> <Cyrillic_te> <space>                                                                           : "ↆ"    # Alternate Roman 50
<Multi_key> <U221D> <Cyrillic_TSE> <space>                                                                          : "Ⅽ"    # Roman 100
<Multi_key> <U221D> <Cyrillic_tse> <space>                                                                          : "ⅽ"    # Roman 100
<Multi_key> <U221D> <U21BA> <Cyrillic_TSE> <space>                                                                  : "Ↄ"    # Alternate Roman 100
<Multi_key> <U221D> <U21BA> <Cyrillic_tse> <space>                                                                  : "ↄ"    # Alternate Roman 100
<Multi_key> <U221D> <Cyrillic_DE> <space>                                                                           : "Ⅾ"    # Roman 500
<Multi_key> <U221D> <Cyrillic_de> <space>                                                                           : "ⅾ"    # Roman 500
<Multi_key> <U221D> <Cyrillic_EM> <space>                                                                           : "Ⅿ"    # Roman 1000
<Multi_key> <U221D> <Cyrillic_em> <space>                                                                           : "ⅿ"    # Roman 1000
<Multi_key> <U221D> <Cyrillic_TSE> <Cyrillic_DE> <space>                                                            : "ↀ"   # Alternate Roman 1000
<Multi_key> <U221D> <Cyrillic_tse> <Cyrillic_de> <space>                                                            : "ↀ"   # Alternate Roman 1000
<Multi_key> <U221D> <Cyrillic_DE> <Cyrillic_DE> <space>                                                             : "ↁ"    # Roman 5000
<Multi_key> <U221D> <Cyrillic_de> <Cyrillic_de> <space>                                                             : "ↁ"    # Roman 5000
<Multi_key> <U221D> <Cyrillic_TSE> <Cyrillic_TSE> <Cyrillic_DE> <Cyrillic_DE> <space>                               : "ↂ"   # Roman 10000
<Multi_key> <U221D> <Cyrillic_tse> <Cyrillic_tse> <Cyrillic_de> <Cyrillic_de> <space>                               : "ↂ"   # Roman 10000
<Multi_key> <U221D> <Cyrillic_DE> <Cyrillic_DE> <Cyrillic_DE> <space>                                               : "ↇ"    # Roman 50000
<Multi_key> <U221D> <Cyrillic_de> <Cyrillic_de> <Cyrillic_de> <space>                                               : "ↇ"    # Roman 50000
<Multi_key> <U221D> <Cyrillic_TSE> <Cyrillic_TSE> <Cyrillic_TSE> <Cyrillic_DE> <Cyrillic_DE> <Cyrillic_DE> <space>  : "ↈ"   # Roman 100000
<Multi_key> <U221D> <Cyrillic_tse> <Cyrillic_tse> <Cyrillic_tse> <Cyrillic_de> <Cyrillic_de> <Cyrillic_de> <space>  : "ↈ"   # Roman 100000

