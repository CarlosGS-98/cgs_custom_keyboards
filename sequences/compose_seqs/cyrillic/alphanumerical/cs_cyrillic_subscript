# Cyrillic Alphabet | SMK Subscript Rules
# [AUTHOR]: Carlos González Sanz
#
# > The purpose of this file is to store additional
# > Compose rules for typing subscript and underscript characters
# > using the caron/háček (<dead_caron>)
# > in conjunction with the Compose Key (<Multi_key>).
#
# [Main source]: https://en.wikipedia.org/wiki/Unicode_subscripts_and_superscripts
#

# Skorpian Underscript Caron (Greek Letters)
<Multi_key> <dead_caron> <dead_caron> <dead_greek> <Cyrillic_i>     : "ͅ"    # Combining Ypogegrammeni
<Multi_key> <dead_caron> <dead_caron> <dead_greek> <Ukrainian_i>    : "ͅ"    # Combining Ypogegrammeni


# Skorpian Underscript Caron (Latin Letters)
<Multi_key> <dead_caron> <dead_caron> <underscore> <Cyrillic_er>                : "᷊"
<Multi_key> <dead_caron> <dead_caron> <underscore> <Cyrillic_softsign>          : "ᪿ"
<Multi_key> <dead_caron> <dead_caron> <underscore> <U21BA> <Cyrillic_softsign>  : "ᫀ"


